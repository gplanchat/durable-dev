{
    "name": "gplanchat/durable-bridge-illuminate",
    "description": "Illuminate (Laravel) journal, metadata and run stores for gplanchat/durable — durable execution on the connection Laravel already owns",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "gplanchat/durable": "self.version",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Bridge\\Illuminate\\": "./"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ]
}
