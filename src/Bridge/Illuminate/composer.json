{
    "name": "gplanchat/durable-bridge-illuminate",
    "description": "Illuminate (Laravel) journal, metadata and run stores for gplanchat/durable — durable execution on the connection Laravel already owns",
    "keywords": [
        "laravel",
        "illuminate",
        "eloquent",
        "event-store",
        "durable-execution",
        "workflow",
        "orchestration",
        "long-running"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "gplanchat/durable": "self.version",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Bridge\\Illuminate\\": "./"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Gplanchat\\Bridge\\Illuminate\\DurableIlluminateServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ],
    "suggest": {
        "illuminate/cache": "Required by Queue\\ResumeLock: a cache store that locks across processes — database, redis, memcached, dynamodb or file. Never array (per-process) or null (locks nothing): both implement LockProvider and neither excludes."
    }
}
