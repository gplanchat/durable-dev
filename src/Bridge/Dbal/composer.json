{
    "name": "gplanchat/durable-bridge-dbal",
    "description": "Doctrine DBAL journal, metadata and parent-link stores for gplanchat/durable — durable execution on a single SQL database, no orchestrator cluster",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "gplanchat/durable": "self.version",
        "doctrine/dbal": "^3.7 || ^4.0",
        "symfony/lock": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Bridge\\Dbal\\": "./"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ]
}
