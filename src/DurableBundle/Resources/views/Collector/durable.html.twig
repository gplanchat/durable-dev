{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{# Macros shared by the time frame bands #}
{% macro timeframe_segment_row(seg) %}
    <div class="durable-timeframe-row">
        <div class="durable-timeframe-label">
            <span class="seq">#{{ seg.seq }}</span>
            {% if seg.category is defined and seg.category %}
                <span class="durable-cat durable-cat--{{ seg.category }}">{{ seg.category }}</span>
            {% endif %}
            <strong>{{ seg.display_title|default(seg.label) }}</strong>
            {% if seg.display_subtitle is defined and seg.display_subtitle %}
                <br><span class="text-muted">{{ seg.display_subtitle }}</span>
            {% endif %}
            <br>
            {% if seg.executionId %}
                <code>{{ seg.executionId|slice(0, 8) }}…</code>
            {% else %}
                <span class="text-muted">—</span>
            {% endif %}
            · {{ seg.durationMs|number_format(3) }}&nbsp;ms
        </div>
        <div class="durable-timeframe-track" title="{{ seg.display_title|default(seg.label) }}">
            {% set barClass = 'durable-timeframe-bar--' ~ (seg.kind in ['dispatch','workflow','activity'] ? seg.kind : 'default') %}
            <div class="durable-timeframe-bar {{ barClass }}"
                 style="left: {{ seg.leftPercent|number_format(4) }}%; width: {{ seg.widthPercent|number_format(4) }}%;"></div>
        </div>
    </div>
{% endmacro %}

{% block head %}
    {{ parent() }}
    <style>
        .durable-timeframe-wrap {
            margin: 1.25em 0;
            padding: 12px;
            background: var(--table-background, #f5f5f5);
            border-radius: 4px;
            border: 1px solid var(--table-border-color, #ddd);
        }
        .durable-timeframe-wrap .durable-timeframe-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1em;
            font-size: 12px;
            margin-bottom: 10px;
        }
        .durable-timeframe-wrap .durable-timeframe-legend span {
            display: inline-flex;
            align-items: center;
            gap: 0.35em;
        }
        .durable-timeframe-wrap .durable-timeframe-swatch {
            width: 12px;
            height: 12px;
            border-radius: 2px;
            display: inline-block;
        }
        .durable-timeframe-wrap .durable-timeframe-axis {
            font-size: 11px;
            color: var(--color-muted, #666);
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
        }
        .durable-timeframe-row {
            display: grid;
            grid-template-columns: minmax(14em, 28%) 1fr;
            gap: 8px;
            align-items: center;
            min-height: 28px;
            font-size: 12px;
            border-bottom: 1px solid var(--table-border-color, #e0e0e0);
            padding: 4px 0;
        }
        .durable-timeframe-row:last-child { border-bottom: none; }
        .durable-timeframe-label {
            word-break: break-word;
        }
        .durable-timeframe-label .seq { color: var(--color-muted, #888); margin-right: 0.35em; }
        .durable-timeframe-label code { font-size: 11px; }
        .durable-timeframe-track {
            position: relative;
            height: 12px;
            background: var(--metric-value-background, #e8e8e8);
            border-radius: 3px;
            overflow: hidden;
        }
        .durable-timeframe-bar {
            position: absolute;
            top: 0;
            height: 100%;
            border-radius: 2px;
            min-width: 2px;
            box-sizing: border-box;
        }
        .durable-timeframe-bar--dispatch { background: #4a90d9; border: 1px solid var(--table-border-color, #ccc); }
        .durable-timeframe-bar--workflow { background: #9b59b6; border: 1px solid var(--table-border-color, #ccc); }
        .durable-timeframe-bar--activity { background: #27ae60; border: 1px solid var(--table-border-color, #ccc); }
        .durable-timeframe-bar--default { background: #95a5a6; }
        .durable-cat {
            display: inline-block;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            padding: 2px 6px;
            border-radius: 3px;
            margin-right: 6px;
            vertical-align: middle;
            background: var(--metric-value-background, #e8e8e8);
            color: var(--color-text, #333);
        }
        .durable-cat--workflow { background: #ede7f6; color: #5e35b1; }
        .durable-cat--activity { background: #e8f5e9; color: #2e7d32; }
        .durable-cat--scheduling { background: #e3f2fd; color: #1565c0; }
        .durable-cat--messenger { background: #e1f5fe; color: #0277bd; }
        .durable-cat--lifecycle { background: #fce4ec; color: #c2185b; }
        .durable-cat--timer { background: #fff3e0; color: #ef6c00; }
        .durable-cat--child { background: #f3e5f5; color: #7b1fa2; }
        .durable-cat--signal { background: #e0f2f1; color: #00695c; }
        .durable-cat--effect { background: #eceff1; color: #455a64; }
        .durable-cat--default { background: #eceff1; color: #546e7a; }
        .durable-summary-table code { font-size: 11px; }
        /* Modelled on the "Workflow" view and its event history (Temporal UI OSS) */
        .durable-exec-header {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 16px;
            margin: 1em 0 1.25em;
            padding: 14px 16px;
            background: var(--table-background, #f0f4f8);
            border: 1px solid var(--table-border-color, #c5d0dc);
            border-radius: 6px;
            font-size: 13px;
        }
        .durable-exec-header dt {
            margin: 0;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--color-muted, #5c6b7a);
        }
        .durable-exec-header dd {
            margin: 0.2em 0 0;
            word-break: break-all;
        }
        .durable-status-badge {
            display: inline-block;
            font-size: 12px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 999px;
        }
        .durable-status-badge--completed { background: #ccfbf1; color: #0f766e; }
        .durable-status-badge--failed { background: #fee2e2; color: #b91c1c; }
        .durable-status-badge--running { background: #dbeafe; color: #1d4ed8; }
        .durable-status-badge--continued_as_new { background: #ede9fe; color: #5b21b6; }
        .durable-status-badge--cancel_requested { background: #ffedd5; color: #c2410c; }
        .durable-status-badge--unknown { background: #e5e7eb; color: #4b5563; }
        .durable-status-badge--pending { background: #fef3c7; color: #92400e; }
        .durable-status-badge--queued { background: #fef9c3; color: #854d0e; }
        h4.durable-section-title { margin-top: 1.5em; margin-bottom: 0.35em; font-size: 14px; }
        .durable-nexus-state { padding: 1px 6px; border-radius: 4px; font-weight: 600; }
        .durable-nexus-state--in_flight { background: #dbeafe; color: #1e40af; }
        .durable-nexus-state--completed { background: #dcfce7; color: #166534; }
        .durable-nexus-state--failed, .durable-nexus-state--timed_out { background: #fee2e2; color: #991b1b; }
        .durable-nexus-state--cancelled { background: #f3f4f6; color: #374151; }
        /* The frieze of the Sylius run page (#819), with the profiler's colour variables: the same
           drawing of the shared RunTimeline, kind rules first, then the hatching, then the red. */
        .durable-frieze { margin: 1em 0 1.25em; }
        .durable-frieze-row { display: flex; align-items: center; gap: .75rem; margin-bottom: .3rem; }
        .durable-frieze-name { flex: 0 0 12rem; text-align: right; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .durable-frieze-track { position: relative; flex: 1 1 auto; height: 1.4rem; background: var(--metric-value-background, #e8e8e8); border: 1px solid var(--table-border-color, #ddd); border-radius: 4px; }
        .durable-frieze-bar { position: absolute; top: .3rem; height: .8rem; min-width: .2rem; border-radius: .4rem; opacity: .35; background: #206bc4; }
        .durable-frieze-mark { position: absolute; top: .4rem; width: .6rem; height: .6rem; margin-left: -.3rem; border-radius: 50%; background: #206bc4; }
        .durable-frieze-bar.execution, .durable-frieze-mark.execution { background: #4b5563; }
        .durable-frieze-bar.activity, .durable-frieze-mark.activity { background: #206bc4; }
        .durable-frieze-bar.signal, .durable-frieze-mark.signal { background: #d63939; }
        .durable-frieze-bar.update, .durable-frieze-mark.update { background: #7048e8; }
        .durable-frieze-bar.nexus, .durable-frieze-mark.nexus { background: #f76707; }
        .durable-frieze-bar.other, .durable-frieze-mark.other { background: #868e96; }
        .durable-frieze-bar.waiting { opacity: .75; background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.9) 0 1px, rgba(255,255,255,0) 1px 3px); }
        .durable-frieze-bar.failed { background-color: #d63939; opacity: .75; }
        .durable-frieze-mark.failed { background-color: #d63939; }
        .durable-frieze-took { flex: 0 0 5rem; font-size: 12px; color: var(--color-muted, #666); }
        .durable-frieze-scale { display: flex; justify-content: space-between; font-size: 12px; color: var(--color-muted, #666); padding: 0 5.75rem 0 12.75rem; }
        .durable-frieze-key { display: flex; align-items: center; gap: .5rem; margin-top: .5rem; padding-left: 12.75rem; font-size: 12px; color: var(--color-muted, #666); }
        .durable-frieze-key .durable-frieze-bar { position: static; top: auto; flex: 0 0 2.5rem; height: .8rem; }
    </style>
{% endblock %}

{% block toolbar %}
    {% set icon %}
        {{ include('@WebProfiler/Icon/workflow.svg') }}
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Dispatch Messenger</b>
            <span>{{ collector.dispatchCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Events (journal)</b>
            <span>{{ collector.journalEventCount }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: 'durable', status: collector.dispatchCount or collector.journalEventCount ? 'normal' : 'gray', icon: icon }) }}
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">{{ include('@WebProfiler/Icon/workflow.svg') }}</span>
        <strong>Durable</strong>
    </span>
    <span class="count">
        <span>{{ collector.dispatchCount }}</span> / <span>{{ collector.journalEventCount }}</span>
    </span>
{% endblock %}

{% block panel %}
    <h2>Durable — executions &amp; history</h2>

    <p class="help">
        To load the journal of an execution the trace does not carry (a worker, another request, and so on),
        it is <strong>the profiled HTTP request</strong> — the one that opens the debug bar, not the profiler URL
        opened afterwards — that must carry <code>durable_execution</code> with the UUID (comma-separated if there
        are several). Reload the application page with that parameter to produce a new profile that includes the
        persisted journal.
    </p>

    <p>
        A view close to the <a href="https://github.com/temporalio/ui" rel="noopener noreferrer" target="_blank">Temporal Web UI</a> (OSS):
        the <strong>executionId</strong> values collected come from the Messenger dispatches on this request; the <strong>history</strong> (runs, activities, timers…)
        is read from the <strong>event store</strong>, even when the workflow ran in a worker or in another request.
    </p>
    <p class="help">
        Reading labels come from <code>DurableProfilerEventPresentation</code>; the "Event type" column keeps the PHP class name
        (the Event Type of Temporal). There is no wall clock: the journal index is the append order, a partial equivalent of the Event ID.
    </p>
    {% if collector.dispatchCount > 0 and collector.journalEventCount == 0 %}
        <p class="help" style="background:#fffbeb;border:1px solid #fcd34d">
            <strong>Journal still empty</strong> for the collected executionId values: the message may still be queued, or no event
            was persisted at all (another database, another environment). If workers consume the queue elsewhere, the journal shows up here as soon as
            the same <code>durable_events</code> database holds rows for those identifiers.
        </p>
    {% endif %}

    {% set tf = collector.timeFrame %}
    {% set processTf = tf.process|default({}) %}
    {% set executionsDetail = collector.executionsDetail|default([]) %}

    <div class="sf-tabs">
        <div class="tab">
            <h3 class="tab-title">Summary <span class="badge">{{ executionsDetail|length }}</span></h3>
            <div class="tab-content">
                {% if executionsDetail is empty %}
                    <p class="help">No execution identified on this request (empty trace, and no <code>executionId</code> collected).</p>
                {% else %}
                    <table class="durable-summary-table">
                        <thead>
                            <tr>
                                <th>Execution</th>
                                <th>Type</th>
                                <th>Outcome</th>
                                <th>Input</th>
                                <th>Process trace (segments)</th>
                                <th>Events</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ex in executionsDetail %}
                                <tr>
                                    <td><code>{{ ex.executionId }}</code></td>
                                    <td><strong>{{ ex.workflowType|default('—') }}</strong></td>
                                    <td>
                                        <span class="durable-status-badge durable-status-badge--{{ ex.executionStatus|default('unknown') }}">{{ ex.executionStatusLabel|default('—') }}</span>
                                    </td>
                                    <td><span class="text-muted">{{ ex.payloadSummary|default('—') }}</span></td>
                                    <td>{{ ex.processTraceCount }} segment(s)</td>
                                    <td>
                                        {{ ex.storeEventCount }} ev.
                                        {% if ex.storeTruncated %}<span class="text-muted">(truncated)</span>{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if collector.runSnapshots|length > 0 %}
                    <h4>Snapshots at dispatch</h4>
                    <p class="help">The state of the metadata at the moment a <code>ResumeWorkflowMessage</code> was observed.</p>
                    <table>
                        <thead>
                            <tr>
                                <th>Execution</th>
                                <th>Metadata</th>
                                <th>Events (count)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for eid, snap in collector.runSnapshots %}
                                <tr>
                                    <td><code>{{ eid }}</code></td>
                                    <td>
                                        {% if snap.metadata is not null %}
                                            <strong>{{ snap.metadata.workflowType }}</strong>
                                            <pre class="text-muted" style="max-height:120px;overflow:auto">{{ snap.metadata.payload|json_encode(128) }}</pre>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ snap.eventCount }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        <div class="tab">
            <h3 class="tab-title">Executions</h3>
            <div class="tab-content">
                {% if executionsDetail is empty %}
                    <p class="help">No execution to show.</p>
                {% else %}
                    <div class="sf-tabs">
                        {% for ex in executionsDetail %}
                            <div class="tab">
                                <h3 class="tab-title">
                                    {% set _wf = ex.workflowType|default('') %}
                                    {% if _wf %}{{ _wf }}{% else %}<span class="text-muted">(no type)</span>{% endif %}
                                    <small><code>{{ ex.executionId|slice(0, 8) }}…</code></small>
                                </h3>
                                <div class="tab-content">
                                    <dl class="durable-exec-header">
                                        <div>
                                            <dt>Execution</dt>
                                            <dd><code>{{ ex.executionId }}</code></dd>
                                        </div>
                                        <div>
                                            <dt>Workflow type</dt>
                                            <dd>{{ _wf|default('—') }}</dd>
                                        </div>
                                        <div>
                                            <dt>Outcome</dt>
                                            <dd>
                                                <span class="durable-status-badge durable-status-badge--{{ ex.executionStatus|default('unknown') }}">{{ ex.executionStatusLabel|default('—') }}</span>
                                            </dd>
                                        </div>
                                        {# What the run last suspended on, from the run catalog (#324). #}
                                        {% if ex.waitingOn|default(null) %}
                                            <div>
                                                <dt>Waiting on</dt>
                                                <dd>{{ ex.waitingOn }}</dd>
                                            </div>
                                        {% endif %}
                                        <div>
                                            <dt>Events (history)</dt>
                                            <dd>
                                                {{ ex.storeEventCount }} in the journal
                                                {% if ex.storeTruncated %}<span class="text-muted"> — display truncated</span>{% endif %}
                                            </dd>
                                        </div>
                                        <div style="grid-column: 1 / -1;">
                                            <dt>Input (initial payload)</dt>
                                            <dd class="text-muted">{{ ex.payloadSummary|default('—') }}</dd>
                                        </div>
                                    </dl>

                                    {# The waits served by someone else (#670): where, and whether they are settled. #}
                                    {% if ex.nexusOperations|default([])|length > 0 %}
                                        <h4>Nexus operations</h4>
                                        {% if ex.storeTruncated %}
                                            <p class="help">The journal is truncated: a state below may already be settled, and later operations are missing.</p>
                                        {% endif %}
                                        <table>
                                            <thead>
                                                <tr><th>Endpoint</th><th>Service</th><th>Operation</th><th>State</th></tr>
                                            </thead>
                                            <tbody>
                                                {% for op in ex.nexusOperations %}
                                                    <tr>
                                                        <td><code>{{ op.endpoint }}</code></td>
                                                        <td>{{ op.service }}</td>
                                                        <td>{{ op.operation }}</td>
                                                        <td><span class="durable-nexus-state durable-nexus-state--{{ op.state }}">{{ op.stateLabel }}</span></td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}

                                    {% if ex.journalHint is defined and ex.journalHint %}
                                        <p class="help" style="background:#fffbeb;border:1px solid #fcd34d;padding:10px 12px;border-radius:6px;">
                                            {{ ex.journalHint }}
                                        </p>
                                    {% endif %}

                                    {% if ex.storeRows|length > 0 %}
                                        <h4 class="durable-section-title">History</h4>
                                        <p class="help">The equivalent of Temporal's <em>Event history</em> tab: the journal in chronological order, the event type, the payload.</p>
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Time (journal)</th>
                                                    <th>Event type</th>
                                                    <th>Category</th>
                                                    <th>Phase</th>
                                                    <th>Summary</th>
                                                    <th>Detail</th>
                                                    <th>Payload</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for row in ex.storeRows %}
                                                    <tr>
                                                        <td>{{ row.index }}</td>
                                                        <td class="text-muted">{% if row.recordedAt %}{{ row.recordedAt }}{% else %}—{% endif %}</td>
                                                        <td><code>{{ row.type }}</code></td>
                                                        <td>{% if row.category %}<span class="durable-cat durable-cat--{{ row.category }}">{{ row.category }}</span>{% else %}—{% endif %}</td>
                                                        <td>{{ row.phase|default('—') }}</td>
                                                        <td><strong>{{ row.title|default(row.label) }}</strong></td>
                                                        <td class="text-muted">{{ row.subtitle|default('') }}</td>
                                                        <td>
                                                            {# Folded, as on the run pages (#820): a disclosure that opens on nothing gets opened again every time. #}
                                                            {% if row.payload is not empty %}
                                                                <details><summary>Payload</summary><pre class="text-muted" style="max-height:100px;overflow:auto">{{ row.payload|json_encode(128) }}</pre></details>
                                                            {% else %}—{% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}

                                    {# The shared RunTimeline, drawn as the Sylius run page draws it (#819): one line
                                       per action, placed in time, the wait for a worker hatched, red on what failed. #}
                                    {% set rt = ex.runTimeline %}
                                    {% if rt.actions is not empty %}
                                        <h4 class="durable-section-title">Timeline</h4>
                                        {% if ex.storeTruncated %}<p class="help">The journal is truncated at 500 events: the timeline stops there.</p>{% endif %}
                                        {% set scale = rt.span > 0 ? 100 / rt.span : 0 %}
                                        <div class="durable-frieze">
                                            {% for action in rt.actions %}
                                                <div class="durable-frieze-row">
                                                    <span class="durable-frieze-name" title="{{ action.label }}">{{ action.label }}</span>
                                                    <div class="durable-frieze-track">
                                                        {% for segment in action.segments %}
                                                            <span class="durable-frieze-bar {{ action.kind }}{{ segment.waiting ? ' waiting' }}{{ segment.failed ? ' failed' }}"
                                                                  style="left: {{ (segment.offset * scale)|number_format(3, '.', '') }}%; width: {{ (segment.duration * scale)|number_format(3, '.', '') }}%"
                                                                  title="{{ segment.title }}"></span>
                                                        {% endfor %}
                                                        {% for mark in action.marks %}
                                                            <span class="durable-frieze-mark {{ action.kind }}{{ mark.failed ? ' failed' }}"
                                                                  style="left: {{ (mark.offset * scale)|number_format(3, '.', '') }}%"
                                                                  title="{{ mark.title }}"></span>
                                                        {% endfor %}
                                                    </div>
                                                    <span class="durable-frieze-took">{{ action.durationLabel }}</span>
                                                </div>
                                            {% endfor %}
                                            <div class="durable-frieze-scale">
                                                <span>0</span>
                                                <span>{{ rt.spanLabel }}</span>
                                            </div>
                                            <div class="durable-frieze-key">
                                                <span class="durable-frieze-bar waiting other"></span>
                                                Hatched: waiting to be picked up. The work was asked for, and no worker had started it yet.
                                            </div>
                                            <div class="durable-frieze-key">
                                                <span class="durable-frieze-bar failed"></span>
                                                Red: what failed. A cancellation stays uncoloured.
                                            </div>
                                        </div>
                                    {% endif %}

                                    {% set ptf = ex.processTimeframe|default({}) %}
                                    {% if ptf.bounds is not null and ptf.segments is not empty %}
                                        <h4 class="durable-section-title">Progress on this request (process timing)</h4>
                                        <p class="help">This trace shows the time this process spent on the run during this request. The Messenger dispatch, the engine turns (start or resume) and the activities run here are measured in the process. The journal records none of them, so the timeline above does not show them.</p>
                                        <div class="durable-timeframe-wrap">
                                            <div class="durable-timeframe-legend">
                                                <span><span class="durable-timeframe-swatch" style="background:#4a90d9"></span> Messenger (ResumeWorkflowMessage)</span>
                                                <span><span class="durable-timeframe-swatch" style="background:#9b59b6"></span> Workflow run (engine)</span>
                                                <span><span class="durable-timeframe-swatch" style="background:#27ae60"></span> Activity</span>
                                            </div>
                                            <div class="durable-timeframe-axis">
                                                <span>0&nbsp;ms</span>
                                                <span>{{ (ptf.bounds.spanSec * 1000)|number_format(3) }}&nbsp;ms</span>
                                            </div>
                                            {% for seg in ptf.segments %}
                                                {{ _self.timeframe_segment_row(seg) }}
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <p class="help">No process trace for this executionId on this request (the workflow or its activities ran elsewhere, or the id was added through <code>durable_execution</code> alone with no activity in this process).</p>
                                    {% endif %}

                                    {% if ex.timelineEntries|length > 0 %}
                                        <h4 class="durable-section-title">Process trace (detail)</h4>
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Type</th>
                                                    <th>Detail</th>
                                                    <th>Duration</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for e in ex.timelineEntries %}
                                                    <tr>
                                                        <td>{{ e.seq }}</td>
                                                        <td>
                                                            {% if e.kind == 'dispatch' %}Messenger{% elseif e.kind == 'workflow' %}Workflow{% elseif e.kind == 'activity' %}Activity{% else %}{{ e.kind|default('?') }}{% endif %}
                                                        </td>
                                                        <td>
                                                            {% if e.kind == 'dispatch' %}
                                                                <strong>{{ e.dispatchSummary|default(e.workflowType|default('—')) }}</strong>
                                                                {% if e.payload|default({}) is not empty %}
                                                                    <details><summary>Payload</summary><pre class="text-muted" style="max-height:80px;overflow:auto">{{ e.payload|json_encode(128) }}</pre></details>
                                                                {% endif %}
                                                            {% elseif e.kind == 'workflow' %}
                                                                {{ e.workflowType }}
                                                            {% elseif e.kind == 'activity' %}
                                                                {{ e.activityName }} <span class="text-muted">({{ e.activityId }})</span>
                                                            {% else %}—{% endif %}
                                                        </td>
                                                        <td>{% if e.kind == 'activity' %}{{ (e.durationSeconds * 1000)|number_format(2) }} ms{% else %}—{% endif %}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="tab">
            <h3 class="tab-title">Overview</h3>
            <div class="tab-content">
                {% if processTf.bounds is not null and processTf.segments is not empty %}
                    <h4>Time frame — all processes together</h4>
                    <div class="durable-timeframe-wrap">
                        <div class="durable-timeframe-axis">
                            <span>0&nbsp;ms</span>
                            <span>{{ (processTf.bounds.spanSec * 1000)|number_format(3) }}&nbsp;ms</span>
                        </div>
                        {% for seg in processTf.segments %}
                            {{ _self.timeframe_segment_row(seg) }}
                        {% endfor %}
                    </div>
                {% endif %}

                {% if collector.timeline|length > 0 %}
                    <h4>Messenger dispatches (this request)</h4>
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Execution</th>
                                <th>Event</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for e in collector.timeline %}
                                <tr>
                                    <td>{{ e.seq }}</td>
                                    <td><code>{{ e.executionId|default('') }}</code></td>
                                    <td>
                                        {% if e.kind == 'dispatch' %}
                                            {{ e.dispatchSummary|default('dispatch ' ~ e.workflowType|default('')) }}
                                        {% elseif e.kind == 'workflow' %}
                                            workflow {{ e.workflowType }} {% if e.isResume %}(resume){% else %}(start){% endif %}
                                        {% elseif e.kind == 'activity' %}
                                            {{ e.activityName }} — {{ (e.durationSeconds * 1000)|number_format(2) }} ms
                                        {% else %}
                                            {{ e.kind|default('') }}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if collector.timeline|length == 0 and executionsDetail is empty %}
                    <p class="help">No data for this request.</p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
