{
    "name": "gplanchat/durable-bundle",
    "description": "Symfony bundle for gplanchat/durable: extension, autoconfiguration of workflows and activities.",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "messenger",
        "durable-execution",
        "workflow",
        "orchestration",
        "long-running",
        "saga"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "gplanchat/durable": "self.version",
        "psr/container": "^2.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^3.0",
        "symfony/uid": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "phpunit/phpunit": "Required by the shipped test helper (Testing\\DurableBundleTestTrait)",
        "symfony/framework-bundle": "Required by consumers of the shipped test helper (Testing\\DurableBundleTestTrait), whose static::getContainer() resolves against a KernelTestCase",
        "symfony/web-profiler-bundle": "Web Debug Toolbar and profiler: Durable panel (workflows / activities)"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Durable\\Bundle\\": "./"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ]
}
