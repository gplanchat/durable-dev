<?php
/**
 * @var \Gplanchat\DurableModule\Block\Adminhtml\ProcessDetail $block
 * @var \Magento\Framework\Escaper $escaper
 */
$run = $block->getRun();
$events = $block->getEvents();
?>
<div class="page-actions">
    <a class="action-default" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
        <?= $escaper->escapeHtml(__('Back to process history')) ?>
    </a>
</div>

<?php if ($run === null): ?>
    <div class="message message-notice">
        <span><?= $escaper->escapeHtml(__(
            'No execution named %1 is known to the backend. It may have been trimmed by the cluster\'s retention, or the identifier may be wrong.',
            $block->getRunId()
        )) ?></span>
    </div>
<?php else: ?>
    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml($run->workflowName) ?></span>
        </div>
        <table class="admin__table-secondary">
            <tr><th><?= $escaper->escapeHtml(__('Run')) ?></th><td><?= $escaper->escapeHtml($run->runId) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Status')) ?></th><td><?= $escaper->escapeHtml($run->status->value) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Started')) ?></th><td><?= $escaper->escapeHtml($block->formatMoment($run->startedAt)) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Ended')) ?></th><td><?= $escaper->escapeHtml($block->formatMoment($run->endedAt)) ?></td></tr>
        </table>
    </div>

    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Journal')) ?></span>
        </div>
        <?php if ($events === []): ?>
            <div class="message message-notice">
                <span><?= $escaper->escapeHtml(__('This execution has no recorded event yet.')) ?></span>
            </div>
        <?php else: ?>
            <table class="admin__table-primary">
                <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('#')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Recorded')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Kind')) ?></th>
                        <th><?= $escaper->escapeHtml(__('What happened')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($events as $event): ?>
                    <tr>
                        <td><?= (int) $event->sequence ?></td>
                        <td><?= $escaper->escapeHtml($event->recordedAt->format('Y-m-d H:i:s')) ?></td>
                        <td><?= $escaper->escapeHtml($event->kind->value) ?></td>
                        <td><?= $escaper->escapeHtml($event->label) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </div>
<?php endif; ?>
