<?php
/**
 * @var \Gplanchat\DurableModule\Block\Adminhtml\ProcessDetail $block
 * @var \Magento\Framework\Escaper $escaper
 */
$run = $block->getRun();
$timeline = $block->getTimeline();
?>
<div class="page-actions">
    <a class="action-default" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
        <?= $escaper->escapeHtml(__('Back to process history')) ?>
    </a>
</div>

<?php if ($run === null): ?>
    <div class="message message-notice">
        <span><?= $escaper->escapeHtml(__(
            'No execution named %1 is known to the backend. It may have been trimmed by the cluster\'s retention, or the identifier may be wrong.',
            $block->getRunId()
        )) ?></span>
    </div>
<?php else: ?>
    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml($run->workflowName) ?></span>
        </div>
        <table class="admin__table-secondary">
            <tr><th><?= $escaper->escapeHtml(__('Run')) ?></th><td><?= $escaper->escapeHtml($run->runId) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Status')) ?></th><td><?= $escaper->escapeHtml($run->status->value) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Started')) ?></th><td><?= $escaper->escapeHtml($block->formatMoment($run->startedAt)) ?></td></tr>
            <tr><th><?= $escaper->escapeHtml(__('Ended')) ?></th><td><?= $escaper->escapeHtml($block->formatMoment($run->endedAt)) ?></td></tr>
        </table>
    </div>

    <?php if ($timeline->actions !== []): ?>
        <div class="admin__page-section">
            <div class="admin__page-section-title">
                <span class="title"><?= $escaper->escapeHtml(__('Timeline')) ?></span>
            </div>
            <?php /* A stylesheet to deploy for a handful of rules would cost the operator more than
                     it returns: a `<style>` here travels with the template. */ ?>
            <style>
                .durable-frieze { margin: 0 0 1rem; }
                .durable-frieze-row { display: flex; align-items: center; gap: .75rem; margin-bottom: .3rem; }
                .durable-frieze-name { flex: 0 0 16rem; text-align: right; font-size: 1.2rem; color: #303030; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
                .durable-frieze-track { position: relative; flex: 1 1 auto; height: 1.8rem; background: #f5f5f5; border: 1px solid #e3e3e3; border-radius: .3rem; }
                /* One `min-width` for both, and that is what holds the rule: four milliseconds of
                   queue must not draw wider than six milliseconds of work. A minimum applied to
                   both makes them equal under the threshold, never inverted. */
                .durable-frieze-bar { position: absolute; top: .4rem; height: 1rem; min-width: .2rem; border-radius: .5rem; opacity: .35; background: #007bdb; }
                .durable-frieze-mark { position: absolute; top: .55rem; width: .7rem; height: .7rem; margin-left: -.35rem; border-radius: 50%; background: #007bdb; }
                .durable-frieze-bar.execution, .durable-frieze-mark.execution { background: #514943; }
                .durable-frieze-bar.activity, .durable-frieze-mark.activity { background: #007bdb; }
                .durable-frieze-bar.signal, .durable-frieze-mark.signal { background: #eb5202; }
                .durable-frieze-bar.update, .durable-frieze-mark.update { background: #7c5ac1; }
                .durable-frieze-bar.nexus, .durable-frieze-mark.nexus { background: #008000; }
                .durable-frieze-bar.other, .durable-frieze-mark.other { background: #a79d95; }
                /* After the per-kind rules, not before: those set `background` as a shorthand,
                   which resets `background-image`. The opacity is raised because a queue of a few
                   milliseconds fits in two pixels, and translucent hatching over two pixels is no
                   longer distinguishable from nothing at all. */
                .durable-frieze-bar.waiting {
                    opacity: .75;
                    background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, .9) 0 1px, rgba(255, 255, 255, 0) 1px 3px);
                }
                /* `background-color` and not `background`: the shorthand would wipe the hatching,
                   and a wait that ends in a failure is both at once. */
                .durable-frieze-bar.failed { background-color: #e02b27; opacity: .75; }
                .durable-frieze-mark.failed { background-color: #e02b27; }
                .durable-journal-failed td { color: #e02b27; }
                .durable-frieze-took { flex: 0 0 6rem; font-size: 1.1rem; color: #757575; }
                .durable-frieze-scale { display: flex; justify-content: space-between; font-size: 1.1rem; color: #757575; padding: 0 6.75rem 0 16.75rem; }
                .durable-frieze-key { display: flex; align-items: center; gap: .5rem; margin-top: .6rem; padding-left: 16.75rem; font-size: 1.1rem; color: #757575; }
                /* The legend swatch steps out of the absolute positioning the frieze bars use. */
                .durable-frieze-key .durable-frieze-bar { position: static; top: auto; flex: 0 0 3rem; }
            </style>
            <div class="durable-frieze">
                <?php foreach ($timeline->actions as $action): ?>
                    <div class="durable-frieze-row">
                        <span class="durable-frieze-name" title="<?= $escaper->escapeHtmlAttr($action->label) ?>"><?= $escaper->escapeHtml($action->label) ?></span>
                        <div class="durable-frieze-track">
                            <?php /* Un segment par intervalle : survoler la longue portion nomme l'attente. */ ?>
                            <?php foreach ($action->segments as $segment): ?>
                                <span class="durable-frieze-bar <?= $escaper->escapeHtmlAttr($action->kind->value) ?><?= $segment->waiting ? ' waiting' : '' ?><?= $segment->failed ? ' failed' : '' ?>"
                                      style="left: <?= $escaper->escapeHtmlAttr($block->scale($segment->offset)) ?>%; width: <?= $escaper->escapeHtmlAttr($block->scale($segment->duration)) ?>%"
                                      title="<?= $escaper->escapeHtmlAttr($segment->title) ?>"></span>
                            <?php endforeach; ?>
                            <?php foreach ($action->events as $mark): ?>
                                <span class="durable-frieze-mark <?= $escaper->escapeHtmlAttr($action->kind->value) ?><?= $mark->event->failed ? ' failed' : '' ?>"
                                      style="left: <?= $escaper->escapeHtmlAttr($block->scale($mark->offset)) ?>%"
                                      title="<?= $escaper->escapeHtmlAttr($mark->title) ?>"></span>
                            <?php endforeach; ?>
                        </div>
                        <span class="durable-frieze-took"><?= $escaper->escapeHtml($action->durationLabel) ?></span>
                    </div>
                <?php endforeach; ?>
                <div class="durable-frieze-scale">
                    <span>0</span>
                    <span><?= $escaper->escapeHtml($timeline->spanLabel) ?></span>
                </div>
                <?php /* Hatching with no legend is a guessing game. */ ?>
                <div class="durable-frieze-key">
                    <span class="durable-frieze-bar waiting other"></span>
                    <?= $escaper->escapeHtml(__('Hatched: waiting to be picked up — the work had been asked for, but nobody had started it yet.')) ?>
                </div>
                <div class="durable-frieze-key">
                    <span class="durable-frieze-bar failed"></span>
                    <?= $escaper->escapeHtml(__('Red: what failed. A cancellation is not painted red — it is an outcome, not a breakdown.')) ?>
                </div>
            </div>
        </div>
    <?php endif; ?>

    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Journal')) ?></span>
        </div>
        <?php $journal = $timeline->journal(); ?>
        <?php if ($journal === []): ?>
            <div class="message message-notice">
                <span><?= $escaper->escapeHtml(__('This execution has no recorded event yet.')) ?></span>
            </div>
        <?php else: ?>
            <table class="admin__table-primary">
                <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('#')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Recorded')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Kind')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Action')) ?></th>
                        <th><?= $escaper->escapeHtml(__('What happened')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($journal as $row): ?>
                    <?php $event = $row->event; ?>
                    <tr<?= $event->failed ? ' class="durable-journal-failed"' : '' ?>>
                        <td><?= (int) $event->sequence ?></td>
                        <td><?= $escaper->escapeHtml($event->recordedAt->format('Y-m-d H:i:s')) ?></td>
                        <td><?= $escaper->escapeHtml($event->kind->value) ?></td>
                        <?php /* The name of the action, not of the event: the follow-ups of an
                                activity carry only a number, and the operator is looking for the
                                name. It is the same string as the frieze row label. */ ?>
                        <td><?= $escaper->escapeHtml($row->actionLabel) ?></td>
                        <td>
                            <?php if ($row->renderedDetails === null): ?>
                                <?= $escaper->escapeHtml($event->label) ?>
                            <?php else: ?>
                                <?php /* Native `<details>`: the browser knows how to fold, and an
                                        operations screen needs no component for that. */ ?>
                                <details>
                                    <summary style="cursor: pointer;"><?= $escaper->escapeHtml($event->label) ?></summary>
                                    <pre style="margin: .5rem 0 0; white-space: pre-wrap; word-break: break-word;"><?= $escaper->escapeHtml($row->renderedDetails) ?></pre>
                                </details>
                            <?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </div>
<?php endif; ?>
