<?php
/**
 * @var \Gplanchat\DurableModule\Block\Adminhtml\ProcessHistory $block
 * @var \Magento\Framework\Escaper $escaper
 */
$health = $block->getHealth();
?>
<?php if (!$block->isReachable()): ?>
    <?php /* An empty grid under a dead cluster teaches the operator there is nothing to see. The
             backend is named so they know what to go and restart, and dated so they know how old
             the answer is. */ ?>
    <div class="message message-error">
        <span><?= $escaper->escapeHtml($health->message) ?></span>
        <span><?= $escaper->escapeHtml(__(
            '%1 · checked at %2',
            $health->backend,
            $health->checkedAt->format('Y-m-d H:i:s')
        )) ?></span>
    </div>
<?php elseif ($block->isEphemeral()): ?>
    <?php /* The third state: it answers, and its answer is empty by construction. Neither an
             outage, nor a working system with nothing to say about it. */ ?>
    <div class="message message-warning">
        <span><?= $escaper->escapeHtml(__(
            'No Temporal DSN is configured, so the journal lives in the process that writes it — and this admin request opened a fresh one. An empty list here is the correct answer, not a failure. Set durable/temporal/dsn in app/etc/env.php to read the cluster.'
        )) ?></span>
        <span><?= $escaper->escapeHtml(__(
            '%1 · checked at %2',
            $health->backend,
            $health->checkedAt->format('Y-m-d H:i:s')
        )) ?></span>
    </div>
<?php else: ?>
    <div class="message message-notice">
        <span><?= $escaper->escapeHtml(__(
            '%1 answers · checked at %2',
            $health->backend,
            $health->checkedAt->format('Y-m-d H:i:s')
        )) ?></span>
    </div>
<?php endif; ?>

<?php $since = new \DateTimeImmutable('-' . $block->getWorkerSilenceSeconds() . ' seconds'); ?>
<?php $polling = []; ?>
<?php foreach ($block->getWorkers() as $role => $queue): ?>
    <?php /* An absent worker fails nothing: executions stop at its first task. Say which command to
             start — but only when the cluster answered: an unanswered probe blames nobody. */ ?>
    <?php if ($queue->polledSince($since)): ?>
        <?php $polling[] = __('%1 on %2 (%3)', $role, $queue->taskQueue, $queue->pollers); ?>
    <?php elseif (null !== $queue->error): ?>
        <div class="message message-warning">
            <span><?= $escaper->escapeHtml(__('Could not ask the cluster who polls %1 (%2 worker): %3', $queue->taskQueue, $role, $queue->error)) ?></span>
        </div>
    <?php else: ?>
        <div class="message message-error">
            <span><?= $escaper->escapeHtml(__(
                'No %1 worker has polled %2 in %3 seconds: executions stop at their first %1 task. Start bin/magento durable:worker --role=%1.',
                $role,
                $queue->taskQueue,
                $block->getWorkerSilenceSeconds()
            )) ?></span>
        </div>
    <?php endif; ?>
<?php endforeach; ?>
<?php if ([] !== $polling): ?>
    <div class="message message-notice">
        <span><?= $escaper->escapeHtml(__('Workers polling: %1', implode(', ', $polling))) ?></span>
    </div>
<?php endif; ?>
<?php if ($block->isReachable()): ?>
    <?php $counters = $block->getCounters(); ?>
    <div class="admin__page-section">
        <?php /* The scope is stated: these counters cover what this screen reads, not the history
                 of the store, and not what the grid filters keep (they apply by AJAX, after this
                 block is rendered). A "total" with twenty under it would suggest a store that
                 recorded five hundred runs has twenty. */ ?>
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__(
                'Outcomes across the %1 most recent runs this screen reads, whatever the grid filters say',
                $block->getWindow()
            )) ?></span>
        </div>
        <table class="admin__table-secondary">
            <tr>
                <?php foreach ($counters as $outcome => $count): ?>
                    <?php $status = \Gplanchat\Durable\Observation\WorkflowRunStatus::tryFrom((string) $outcome); ?>
                    <th><?= $escaper->escapeHtml($status !== null ? \Gplanchat\DurableModule\Ui\OutcomeLabel::of($status) : __('In the window')) ?></th>
                <?php endforeach; ?>
            </tr>
            <tr>
                <?php foreach ($counters as $count): ?>
                    <td><?= (int) $count ?></td>
                <?php endforeach; ?>
            </tr>
        </table>
    </div>
    <?php if ($counters['total'] >= $block->getWindow()): ?>
        <?php /* A bounded window that does not announce itself is discovered through a missing run. */ ?>
        <div class="message message-notice">
            <span><?= $escaper->escapeHtml(__(
                'This screen reads the %1 most recent runs. Older ones are beyond what it can list or open.',
                $block->getWindow()
            )) ?></span>
        </div>
    <?php endif; ?>
<?php endif; ?>
