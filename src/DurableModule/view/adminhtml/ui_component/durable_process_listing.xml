<?xml version="1.0"?>
<!--
    The standard Magento grid, not a hand-written table: the operator finds the paging, the
    bookmarks, the column selection and the export they know from every other grid, and we
    reimplement none of them.

    The source is not an SQL collection — it queries the cluster — hence a bespoke data provider.
    See `Ui\DataProvider\ProcessListing` for what that costs: the grid pages by offset, the cluster
    by cursor, so the window is bounded and says so.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">durable_process_listing.durable_process_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>durable_process_columns</spinner>
        <deps>
            <dep>durable_process_listing.durable_process_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="durable_process_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">run_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Gplanchat_DurableModule::process_history</aclResource>
        <dataProvider class="Gplanchat\DurableModule\Ui\DataProvider\ProcessListing"
                      name="durable_process_listing_data_source">
            <settings>
                <requestFieldName>run_id</requestFieldName>
                <primaryFieldName>run_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <paging name="listing_paging"/>
        <!--
            The `select` filters become `ui-select`: several states at once rather than a single
            one. It is the template the Magento core uses for the same thing, not a bespoke
            component.
        -->
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <columnsControls name="columns_controls"/>
    </listingToolbar>

    <columns name="durable_process_columns">
        <column name="run_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Run</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="workflow_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Workflow</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Gplanchat\DurableModule\Ui\Component\Listing\Column\StatusOptions"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="started_at">
            <settings>
                <label translate="true">Started</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="ended_at">
            <settings>
                <label translate="true">Ended</label>
                <sortable>false</sortable>
            </settings>
        </column>

        <actionsColumn name="actions" class="Gplanchat\DurableModule\Ui\Component\Listing\Column\ProcessActions">
            <settings>
                <indexField>run_id</indexField>
                <label translate="true">Action</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
