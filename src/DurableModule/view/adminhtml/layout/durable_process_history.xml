<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!--
                The warning first, the grid second. With no DSN an empty list is the right answer
                and not an outage — but only this banner can say so, a grid has nowhere to explain
                it.
            -->
            <block class="Gplanchat\DurableModule\Block\Adminhtml\ProcessHistory"
                   name="durable.process.notice"
                   template="Gplanchat_DurableModule::process/notice.phtml"/>
            <uiComponent name="durable_process_listing"/>
        </referenceContainer>
    </body>
</page>
