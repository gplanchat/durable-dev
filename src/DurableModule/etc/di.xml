<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        The command joins `bin/magento`'s list. It is the only point where the
        module touches Magento: everything else is ordinary PHP that the
        container instantiates knowing nothing about Durable.
    -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="durable_worker" xsi:type="object">Gplanchat\DurableModule\Console\Command\RunWorkerCommand</item>
                <item name="durable_health" xsi:type="object">Gplanchat\DurableModule\Console\Command\HealthCommand</item>
            </argument>
        </arguments>
    </type>

    <!--
        Declaration, for want of tags. Magento's container has no equivalent of Symfony's
        attribute autoconfiguration: a workflow class is named, an activity handler is placed.
        What is **not** declared is a handler's contract — the factory reads its interfaces and
        keeps those carrying `#[AsActivityMethod]`. One declaration fewer to get wrong, and the
        names stay the attributes'.

        Both arrays are **empty** in the published package, and that is deliberate: an integration
        module has no business shipping demonstration workflows that every consuming project would
        then carry for nothing. The demonstration lives in this repository's bench
        (`magento/app/code/Gplanchat/DurableProbe`), which shows exactly these two declarations.

        This is where a project adds its own:

            <item name="place_order" xsi:type="string">Acme\Shop\Workflow\PlaceOrder</item>
            <item name="order" xsi:type="object">Acme\Shop\Activity\OrderActivities</item>
    -->
    <type name="Gplanchat\DurableModule\Runtime\RuntimeFactory">
        <arguments>
            <argument name="workflowClasses" xsi:type="array">
            </argument>
            <!--
                ⚠ An **optional** constructor argument is not autowired: Magento takes its
                default. Without this line, `deploymentConfig` stays `null`, the DSN is never read,
                and the module serves an in-memory journal while `env.php` asks for the cluster —
                with not one line of error anywhere. The nullable exists so the factory stays
                constructible outside Magento, under unit test; the container has to say it.
            -->
            <argument name="deploymentConfig" xsi:type="object">Magento\Framework\App\DeploymentConfig</argument>
            <!-- The same shared instance the activities inject: on Temporal the factory points it at
                 the worker's sender (#510). Optional arguments are not autowired, hence here. -->
            <argument name="heartbeat" xsi:type="object">Gplanchat\Durable\Port\ActivityHeartbeatSenderInterface</argument>
            <!-- Optional too: without it the Temporal client built by the factory logs nothing. -->
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
            <!--
                The payload codec (DUR055), none by default. Optional, so not autowired: a shop that
                encrypts its payloads names its codec in its own module's di.xml, whose module.xml
                declares <sequence><module name="Gplanchat_DurableModule"/></sequence>. The codec
                reads its key from env.php; Durable reads none:

                    <argument name="codec" xsi:type="object">Acme\Shop\Temporal\PayloadCodec</argument>

                Deliberately not declared here, not even as null: whenever this module loaded after
                the shop's, its declaration would replace the shop's codec, and payloads would leave
                in clear.
            -->
            <argument name="activityHandlers" xsi:type="array">
            </argument>
            <!-- Nexus handlers (#668): one object per handler, its contract named by
                 #[AsNexusServiceHandler] on the class; the operations it has no method for come
                 from a workflowClasses entry carrying #[FulfilsNexusOperation]. Served by
                 the nexus role of bin/magento durable:worker. -->
            <argument name="nexusHandlers" xsi:type="array">
            </argument>
        </arguments>
    </type>

    <!--
        What the run page masks in each event's details (#507): #488's key pattern. An application
        that masks more declares its own preference for the interface.

        Through a virtual type: `setup:di:compile` compiles modules and registered libraries only,
        and refuses a preference aimed straight at a class of `gplanchat/durable` (#725).
    -->
    <virtualType name="Gplanchat\DurableModule\Observation\PayloadRedactor"
                 type="Gplanchat\Durable\Observation\KeyPatternPayloadRedactor"/>
    <preference for="Gplanchat\Durable\Observation\PayloadRedactorInterface"
                type="Gplanchat\DurableModule\Observation\PayloadRedactor"/>

    <!--
        An activity may inject the heartbeat sender (the activities page shows how). This one is a
        no-op in process, and leads to the Temporal worker's sender once the factory built it.
    -->
    <preference for="Gplanchat\Durable\Port\ActivityHeartbeatSenderInterface"
                type="Gplanchat\DurableModule\Runtime\SharedActivityHeartbeatSender"/>
</config>
