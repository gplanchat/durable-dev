{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}Durable Workflow Dashboard | {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .durable-kpi-value { font-size: 1.35rem; font-weight: 600; line-height: 1.2; }
        .durable-run-row { border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius); padding: .65rem; text-decoration: none; display: block; color: inherit; }
        .durable-run-row:hover { border-color: var(--tblr-primary); }
        .durable-run-row.active { border-color: var(--tblr-primary); box-shadow: inset 0 0 0 1px var(--tblr-primary); }
        .durable-status { font-size: .7rem; text-transform: uppercase; letter-spacing: .02em; }
        .durable-meta { color: var(--tblr-secondary-color); font-size: .82rem; display: flex; gap: .35rem .65rem; flex-wrap: wrap; }
        .durable-track { position: relative; border: 1px solid #d1d5db; background: #f9fafb; height: 12px; border-radius: 999px; }
        .durable-bar { position: absolute; top: 1px; height: 8px; border-radius: 999px; min-width: 3px; }
        .durable-bar.execution { background: #93c5fd; }
        .durable-bar.activity { background: #a7f3d0; }
        .durable-bar.signal { background: #fbcfe8; }
        .durable-bar.query { background: #fde68a; }
        .durable-bar.update { background: #c4b5fd; }
        .durable-events { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
        .durable-events li { border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius); padding: .5rem .65rem; background: var(--tblr-bg-surface); }
    </style>
{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}
    {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

    <div class="page-wrapper">
        <div class="container-xl my-4">
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h1 class="h2 mb-1">Durable Workflow Dashboard</h1>
                        <p class="text-secondary mb-0">Observe workflow runs, statuses and recent events from the Sylius back-office.</p>
                    </div>
                </div>

                <div class="row row-cards">
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-secondary text-uppercase small">Total</div>
                                <div class="durable-kpi-value">{{ kpis.total }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-secondary text-uppercase small">Running</div>
                                <div class="durable-kpi-value">{{ kpis.running }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-secondary text-uppercase small">Completed</div>
                                <div class="durable-kpi-value">{{ kpis.completed }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-secondary text-uppercase small">Failed</div>
                                <div class="durable-kpi-value">{{ kpis.failed }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        {% set refreshParams = { q: query, status: status, cursor: pagination.cursor } %}
                        {% if selectedRunId is not empty %}
                            {% set refreshParams = refreshParams|merge({ run: selectedRunId }) %}
                        {% endif %}
                        <div class="alert {% if temporal.connected %}alert-success{% else %}alert-warning{% endif %}" role="alert">
                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                <div class="d-flex flex-column gap-1">
                                    <span>{{ temporal.message }}</span>
                                    <small class="text-secondary">
                                        Check: {{ temporal.checkedAt ?: 'n/a' }}
                                        {% if temporal.lastSuccessfulAt %}
                                            · Last successful sync: {{ temporal.lastSuccessfulAt }}
                                        {% else %}
                                            · No successful sync yet
                                        {% endif %}
                                    </small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    {% if temporal.namespace %}
                                        <span class="badge bg-secondary-lt text-secondary">namespace: {{ temporal.namespace }}</span>
                                    {% endif %}
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('gplanchat_durable_plugin_admin_dashboard', refreshParams|merge({ _refresh: date().timestamp })) }}">
                                        Refresh
                                    </a>
                                </div>
                            </div>
                        </div>

                        <form class="row g-2 align-items-end" method="get" action="{{ path('gplanchat_durable_plugin_admin_dashboard') }}">
                            <div class="col-md-7">
                                <label for="q" class="form-label">Search</label>
                                <input id="q" class="form-control" type="search" name="q" value="{{ query }}" placeholder="run id, workflow, task queue">
                            </div>
                            <div class="col-md-3">
                                <label for="status" class="form-label">Status</label>
                                <select id="status" class="form-select" name="status">
                                    <option value="all" {% if status == 'all' %}selected{% endif %}>All</option>
                                    <option value="running" {% if status == 'running' %}selected{% endif %}>Running</option>
                                    <option value="completed" {% if status == 'completed' %}selected{% endif %}>Completed</option>
                                    <option value="failed" {% if status == 'failed' %}selected{% endif %}>Failed</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-primary">Filter</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-xl-4">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Runs</h3>
                            </div>
                            <div class="card-body">
                                {% if runs is empty %}
                                    <p class="text-secondary mb-0">No workflow run matches your filters.</p>
                                {% else %}
                                    {% for run in runs %}
                                        <a class="durable-run-row {% if selectedRunId == run.runId %}active{% endif %}" href="{{ path('gplanchat_durable_plugin_admin_dashboard', { q: query, status: status, run: run.runId, cursor: pagination.cursor }) }}">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <strong>{{ run.workflowName }}</strong>
                                                <span class="badge durable-status {% if run.status == 'running' %}bg-blue-lt text-blue{% elseif run.status == 'completed' %}bg-green-lt text-green{% else %}bg-red-lt text-red{% endif %}">{{ run.status|upper }}</span>
                                            </div>
                                            <div class="durable-meta mt-1">
                                                <code>{{ run.runId }}</code>
                                                <span>{{ run.startedAt }}</span>
                                                <span>Queue: {{ run.taskQueue }}</span>
                                                <span>Duration: {{ run.duration }}</span>
                                            </div>
                                        </a>
                                    {% endfor %}
                                {% endif %}

                                {% if pagination.hasNext %}
                                    <div class="mt-3">
                                        <a class="btn btn-outline-primary btn-sm" href="{{ path('gplanchat_durable_plugin_admin_dashboard', { q: query, status: status, cursor: pagination.nextCursor }) }}">Next page</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-8">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Run details</h3>
                            </div>
                            <div class="card-body">
                                {% if selectedRun %}
                                    <p><strong>Workflow:</strong> {{ selectedRun.workflowName }}</p>
                                    <p><strong>Run ID:</strong> <code>{{ selectedRun.runId }}</code></p>
                                    <p><strong>Status:</strong> {{ selectedRun.status|upper }}</p>

                                    {% if selectedRun.timeline is defined and selectedRun.timeline.lanes is not empty %}
                                        <h4 class="mt-4">Timeline</h4>
                                        {% for lane in selectedRun.timeline.lanes %}
                                            <div class="row g-2 align-items-center mb-2">
                                                <div class="col-lg-4 text-secondary">{{ lane.label }}</div>
                                                <div class="col-lg-8">
                                                    <div class="durable-track">
                                                        <span class="durable-bar {{ lane.kind }}" style="left: {{ lane.startPercent }}%; width: {{ lane.widthPercent }}%;"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% endif %}

                                    <h4 class="mt-4">Recent events</h4>
                                    <ul class="durable-events">
                                        {% for event in selectedRun.events %}
                                            <li><strong>#{{ event.eventId }}</strong> {{ event.time }} - <code>{{ event.type }}</code> ({{ event.category }})</li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="text-secondary mb-0">Select a run in the list to inspect details.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
