# Example override (e.g. `.env.local`) if you do not want to use the values from `.env.dev`.
# Prerequisites: `docker compose up -d`, ext-grpc, port = TEMPORAL_FRONTEND_PORT.
#
# Journal (Durable events → "DurableJournal" Temporal workflows in the UI):
DURABLE_TEMPORAL_DSN=temporal://127.0.0.1:7234?namespace=default&journal_task_queue=durable-journal&tls=0
