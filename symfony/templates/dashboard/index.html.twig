{% extends 'base.html.twig' %}

{% block title %}Workflow Dashboard — Durable{% endblock %}

{% block body %}
<div class="container ds-page">
    <div class="page-intro">
        <h1>Workflow Dashboard</h1>
        <p>Follow the state of running executions, spot failures quickly and inspect one execution in detail without leaving the page.</p>
    </div>

    <section class="ds-kpi-grid" aria-label="Workflow indicators">
        <article class="ds-kpi">
            <span class="ds-kpi__label">Total</span>
            <strong class="ds-kpi__value">{{ kpis.total }}</strong>
        </article>
        <article class="ds-kpi">
            <span class="ds-kpi__label">Running</span>
            <strong class="ds-kpi__value">{{ kpis.running }}</strong>
        </article>
        <article class="ds-kpi">
            <span class="ds-kpi__label">Completed</span>
            <strong class="ds-kpi__value">{{ kpis.completed }}</strong>
        </article>
        <article class="ds-kpi">
            <span class="ds-kpi__label">Failed</span>
            <strong class="ds-kpi__value">{{ kpis.failed }}</strong>
        </article>
    </section>

    <form class="ds-filters" method="get" action="{{ path('app_dashboard') }}">
        <div>
            <label for="filter-q">Search</label>
            <input id="filter-q" class="ds-input" type="search" name="q" value="{{ query }}" placeholder="run id, workflow, queue">
        </div>
        <div>
            <label for="filter-status">Status</label>
            <select id="filter-status" class="ds-select" name="status">
                <option value="all" {% if status == 'all' %}selected{% endif %}>All</option>
                <option value="running" {% if status == 'running' %}selected{% endif %}>Running</option>
                <option value="completed" {% if status == 'completed' %}selected{% endif %}>Completed</option>
                <option value="failed" {% if status == 'failed' %}selected{% endif %}>Failed</option>
            </select>
        </div>
        {% if selectedRunId %}
            <input type="hidden" name="run" value="{{ selectedRunId }}">
        {% endif %}
        {% if pagination.cursor %}
            <input type="hidden" name="cursor" value="{{ pagination.cursor }}">
        {% endif %}
        {% if pagination.stack %}
            <input type="hidden" name="stack" value="{{ pagination.stack }}">
        {% endif %}
        <input type="hidden" name="animate" value="{{ animateTimelapse ? '1' : '0' }}">
        {% for kind in timelineControls.visibleKinds %}
            <input type="hidden" name="kinds[]" value="{{ kind }}">
        {% endfor %}
        <button type="submit" class="ds-btn ds-btn--primary">Filter</button>
    </form>

    <section class="ds-dashboard-split">
        <aside class="ds-dashboard-list" aria-label="Workflow list">
            <div class="ds-pagination">
                <span class="ds-pagination__label">Execution navigation</span>
                <span class="ds-pagination__cursor">Showing {{ runs|length }} execution{{ runs|length != 1 ? 's' : '' }} (max {{ pagination.pageSize }} per page)</span>
                <div class="hstack">
                    {% if pagination.hasPrevious %}
                        <a class="btn btn-ghost btn-sm" href="{{ path('app_dashboard', {
                            q: query,
                            status: status,
                            animate: animateTimelapse ? '1' : '0',
                            cursor: pagination.previousCursor,
                            stack: pagination.previousStack,
                            kinds: timelineControls.visibleKinds
                        }) }}">← Previous page</a>
                    {% else %}
                        <span class="ds-pagination__disabled">← Previous page</span>
                    {% endif %}
                    {% if pagination.hasNext %}
                        <a class="btn btn-ghost btn-sm" href="{{ path('app_dashboard', {
                            q: query,
                            status: status,
                            animate: animateTimelapse ? '1' : '0',
                            cursor: pagination.nextCursor,
                            stack: pagination.nextStack,
                            kinds: timelineControls.visibleKinds
                        }) }}">Next page →</a>
                    {% else %}
                        <span class="ds-pagination__disabled">Next page →</span>
                    {% endif %}
                </div>
            </div>

            {% if runs is empty %}
                <p class="ds-empty-state">No workflow matches the filters.</p>
            {% else %}
                {% for run in runs %}
                    <a class="ds-run-row{% if selectedRunId == run.runId %} is-active{% endif %}"
                       href="{{ path('app_dashboard', {
                           q: query,
                           status: status,
                           animate: animateTimelapse ? '1' : '0',
                           run: run.runId,
                           cursor: pagination.cursor,
                           stack: pagination.stack,
                           kinds: timelineControls.visibleKinds
                       }) }}">
                        <div class="ds-run-row__title">
                            <span>{{ run.workflowName }}</span>
                            <span class="ds-status-badge ds-status-badge--{{ run.status }}">{{ run.status|upper }}</span>
                        </div>
                        <div class="ds-run-row__meta">
                            <code class="ds-mono">{{ run.runId }}</code>
                            <span>{{ run.startedAt }}</span>
                            <span>Queue: {{ run.taskQueue }}</span>
                            <span>Duration: {{ run.duration }}</span>
                        </div>
                    </a>
                {% endfor %}
            {% endif %}
        </aside>

        <main class="ds-dashboard-detail" aria-label="Execution detail">
            {% if selectedRun %}
                <div class="result-card">
                    <div class="result-card-header">Selected execution</div>
                    <div class="result-card-body">
                        <dl class="meta-list">
                            <dt>Workflow</dt>
                            <dd>{{ selectedRun.workflowName }}</dd>
                            <dt>Run ID</dt>
                            <dd><code class="ds-mono">{{ selectedRun.runId }}</code></dd>
                            <dt>Status</dt>
                            <dd><span class="ds-status-badge ds-status-badge--{{ selectedRun.status }}">{{ selectedRun.status|upper }}</span></dd>
                            <dt>Started At</dt>
                            <dd>{{ selectedRun.startedAt }}</dd>
                            <dt>Task Queue</dt>
                            <dd>{{ selectedRun.taskQueue }}</dd>
                            <dt>Duration</dt>
                            <dd>{{ selectedRun.duration }}</dd>
                        </dl>
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-header">Timeline frieze</div>
                    <div class="result-card-body">
                        <div class="ds-timelapse-controls">
                            <form method="get" action="{{ path('app_dashboard') }}" class="ds-timelapse-controls__kinds">
                                <input type="hidden" name="q" value="{{ query }}">
                                <input type="hidden" name="status" value="{{ status }}">
                                <input type="hidden" name="run" value="{{ selectedRun.runId }}">
                                <input type="hidden" name="cursor" value="{{ pagination.cursor }}">
                                <input type="hidden" name="stack" value="{{ pagination.stack }}">
                                <input type="hidden" name="animate" value="{{ animateTimelapse ? '1' : '0' }}">
                                <span class="ds-timelapse-controls__label">Lanes</span>
                                {% for kind in timelineControls.availableKinds %}
                                    <label class="ds-kind-toggle">
                                        <input type="checkbox" name="kinds[]" value="{{ kind }}" {% if kind in timelineControls.visibleKinds %}checked{% endif %}>
                                        <span>{{ kind|upper }}</span>
                                    </label>
                                {% endfor %}
                                <button type="submit" class="btn btn-ghost btn-sm">Apply</button>
                            </form>
                            <form method="get" action="{{ path('app_dashboard') }}" class="ds-timelapse-controls__kinds">
                                <input type="hidden" name="q" value="{{ query }}">
                                <input type="hidden" name="status" value="{{ status }}">
                                <input type="hidden" name="run" value="{{ selectedRun.runId }}">
                                <input type="hidden" name="cursor" value="{{ pagination.cursor }}">
                                <input type="hidden" name="stack" value="{{ pagination.stack }}">
                                {% for kind in timelineControls.visibleKinds %}
                                    <input type="hidden" name="kinds[]" value="{{ kind }}">
                                {% endfor %}
                                <span class="ds-timelapse-controls__label">Animation</span>
                                <label class="ds-kind-toggle">
                                    <input type="radio" name="animate" value="1" {% if animateTimelapse %}checked{% endif %}>
                                    <span>Animated</span>
                                </label>
                                <label class="ds-kind-toggle">
                                    <input type="radio" name="animate" value="0" {% if not animateTimelapse %}checked{% endif %}>
                                    <span>Disabled</span>
                                </label>
                                <button type="submit" class="btn btn-ghost btn-sm">Save</button>
                            </form>
                        </div>

                        {% if selectedRun.timeline is defined and selectedRun.timeline.lanes is not empty %}
                            <div class="ds-timelapse{% if not animateTimelapse %} ds-timelapse--static{% endif %}">
                                <div class="ds-timelapse__legend" aria-label="Frieze legend">
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-dot ds-timelapse__legend-dot--execution"></span>Execution</span>
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-dot ds-timelapse__legend-dot--activity"></span>Activity</span>
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-dot ds-timelapse__legend-dot--signal"></span>Signal</span>
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-dot ds-timelapse__legend-dot--query"></span>Query</span>
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-dot ds-timelapse__legend-dot--update"></span>Update</span>
                                    <span class="ds-timelapse__legend-item"><span class="ds-timelapse__legend-hatch"></span>Hatched = running</span>
                                </div>

                                <div class="ds-timelapse__viewport">
                                    <div class="ds-timelapse__canvas">
                                        <div class="ds-timelapse__header">
                                            <span>{{ selectedRun.timeline.startTime }}</span>
                                            <span>{{ selectedRun.timeline.endTime }}</span>
                                        </div>
                                <div class="ds-timelapse__window-info">
                                    Active window: <code>{{ selectedRun.timeline.startTime }} → {{ selectedRun.timeline.endTime }}</code>
                                    · Visible duration: <code>{{ selectedRun.timeline.windowDurationLabel }}</code>
                                </div>
                                        {% for lane in selectedRun.timeline.lanes %}
                                            <div class="ds-timelapse__lane">
                                                <div class="ds-timelapse__lane-label">{{ lane.label }}</div>
                                                <div class="ds-timelapse__track">
                                                    <span class="ds-timelapse__bar ds-timelapse__bar--{{ lane.kind }}{% if lane.isRunning %} ds-timelapse__bar--running{% endif %}"
                                                          style="left: {{ lane.startPercent }}%; width: {{ lane.widthPercent }}%;"
                                                          title="Workflow: {{ selectedRun.workflowName }}&#10;Run ID: {{ selectedRun.runId }}&#10;Status: {{ selectedRun.status|upper }}&#10;Lane: {{ lane.label }}&#10;Type: {{ lane.kind|upper }}{% if lane.isRunning %} (RUNNING){% endif %}&#10;Start: {{ lane.startTime }}&#10;End: {{ lane.endTime }}"></span>
                                                </div>
                                                <div class="ds-timelapse__lane-time">{{ lane.startTime }} → {{ lane.endTime }}</div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p class="ds-empty-state">No timeline data available for this execution.</p>
                        {% endif %}
                    </div>
                </div>

                <div class="result-card">
                    <div class="result-card-header">Event history</div>
                    <div class="result-card-body">
                        <ol class="ds-timeline">
                            {% for event in selectedRun.events %}
                                <li class="ds-timeline__item">
                                    <span class="ds-timeline__dot"></span>
                                    <div class="ds-timeline__content">
                                        <div class="ds-timeline__meta">
                                            <span class="ds-event__time">{{ event.time }}</span>
                                            <span class="ds-event__id">#{{ event.eventId }}</span>
                                            <span class="ds-event-kind ds-event-kind--{{ event.category }}">{{ event.category|upper }}</span>
                                        </div>
                                        <code class="ds-mono">{{ event.type }}</code>
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </div>
            {% else %}
                <div class="result-card">
                    <div class="result-card-body">
                        <p class="ds-empty-state">Select an execution from the list to see its detail.</p>
                    </div>
                </div>
            {% endif %}
        </main>
    </section>
</div>
{% endblock %}
