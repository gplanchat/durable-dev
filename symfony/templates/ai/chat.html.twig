{% extends 'base.html.twig' %}

{% block title %}Chat durable — Durable{% endblock %}

{% block body %}
<div class="container-sm">
    <div style="margin-bottom: 1.5rem;">
        <a href="{{ path('durable_samples_index') }}" class="back-link">← Retour aux samples</a>
    </div>

    <div class="page-intro">
        <h1>Chat durable</h1>
        <p>
            Une conversation = <strong>une exécution de workflow</strong>. Chaque message part en
            <strong>signal</strong> ; entre deux messages le workflow n’attend pas dans un processus,
            il est <em>suspendu</em>. Le fil affiché est une projection du journal — rien n’est stocké
            en session.
        </p>
        <p>
            Chaque appel d’outil passe par une <strong>garde</strong>. Le mode décide de ce qui passe
            sans demander ; le reste <em>suspend le workflow</em> jusqu’à ta décision — signal
            <code>tool_decision</code>. Essaie « envoie un mail » en mode <code>auto</code> puis en
            <code>standard</code>.
        </p>
    </div>

    <div class="chat">
        <div class="chat-meta">
            <span>executionId</span>
            <code>{{ executionId }}</code>
            <label class="chat-mode">
                mode
                <select id="mode" class="ds-input">
                    <option value="standard">standard — seules les lectures passent</option>
                    <option value="edition">edition — les écritures passent</option>
                    <option value="auto">auto — tout passe</option>
                </select>
            </label>
            <span class="chat-state" id="state">…</span>
        </div>

        <div id="approvals"></div>

        <div class="chat-thread" id="thread"></div>

        <form class="chat-form" id="form" autocomplete="off">
            <input class="ds-input" id="text" name="text" placeholder="Demande la météo à Paris, à Lyon…" required>
            <button class="btn btn-primary" type="submit">Envoyer</button>
        </form>
    </div>
</div>

<style>
    .chat { display: flex; flex-direction: column; gap: 1rem; }
    .chat-meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: .82rem; color: var(--ds-text-muted); }
    .chat-state { margin-left: auto; padding: .1rem .55rem; border-radius: 999px; border: 1px solid var(--ds-border-soft); }
    .chat-state[data-working="1"] { color: var(--ds-warning); border-color: var(--ds-warning); }
    .chat-thread { display: flex; flex-direction: column; gap: .7rem; min-height: 18rem; max-height: 60vh; overflow-y: auto;
        padding: 1rem; background: rgba(21, 15, 35, .55); border: 1px solid var(--ds-border); border-radius: var(--radius); }
    .msg { max-width: 82%; padding: .6rem .85rem; border-radius: var(--radius); line-height: 1.5; white-space: pre-wrap; }
    .msg-user { align-self: flex-end; background: var(--ds-surface-alt); border: 1px solid var(--ds-border-soft); }
    .msg-assistant { align-self: flex-start; background: var(--ds-surface); border: 1px solid var(--ds-border); }
    .msg-tool { align-self: flex-start; max-width: 92%; font-family: var(--font-mono); font-size: .8rem;
        color: var(--ds-text-muted); background: transparent; border: 1px dashed var(--ds-border-soft); }
    .msg-tool b { color: var(--ds-accent); font-weight: 500; }
    .chat-mode { display: inline-flex; align-items: center; gap: .4rem; }
    .chat-mode select { padding: .15rem .4rem; font-size: .8rem; }
    .approval { border: 1px solid var(--ds-warning); border-radius: var(--radius); padding: .8rem 1rem;
        background: rgba(255, 178, 135, .08); display: flex; flex-direction: column; gap: .6rem; margin-bottom: .8rem; }
    .approval-title { font-weight: 500; color: var(--ds-warning); }
    .approval code { display: block; margin-top: .3rem; white-space: pre-wrap; }
    .approval-actions { display: flex; gap: .5rem; }
    .chat-form { display: flex; gap: .6rem; }
    .chat-form .ds-input { flex: 1; }
    .chat-empty { color: var(--ds-text-muted); font-size: .9rem; margin: auto; }
</style>

<script>
(function () {
    const base = {{ path('durable_chat_show', {executionId: executionId})|json_encode|raw }};
    const thread = document.getElementById('thread');
    const state = document.getElementById('state');
    const form = document.getElementById('form');
    const approvals = document.getElementById('approvals');
    const mode = document.getElementById('mode');
    const input = document.getElementById('text');
    let pending = null;

    const bubble = (cls, html) => {
        const el = document.createElement('div');
        el.className = 'msg ' + cls;
        el.innerHTML = html;
        return el;
    };
    const escape = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

    async function refresh() {
        let data;
        try { data = await (await fetch(base + '/transcript')).json(); } catch (e) { return; }

        const atBottom = thread.scrollTop + thread.clientHeight >= thread.scrollHeight - 40;
        thread.replaceChildren();

        for (const m of data.messages) {
            if (m.role === 'user') {
                thread.append(bubble('msg-user', escape(m.content)));
            } else if (m.role === 'tool') {
                thread.append(bubble('msg-tool', '⚙ <b>outil</b> → ' + escape(m.content)));
            } else if (m.role === 'assistant' && m.content) {
                thread.append(bubble('msg-assistant', escape(m.content)));
            } else if (m.role === 'assistant' && m.tool_calls) {
                for (const c of m.tool_calls) {
                    thread.append(bubble('msg-tool', '⚙ appel <b>' + escape(c.function.name) + '</b> ' + escape(c.function.arguments)));
                }
            }
        }

        if (pending) { thread.append(bubble('msg-user', escape(pending))); }
        if (!thread.childElementCount) {
            const empty = document.createElement('p');
            empty.className = 'chat-empty';
            empty.textContent = 'Le workflow est démarré et suspendu. Envoie un message pour le réveiller.';
            thread.append(empty);
        }

        approvals.replaceChildren();
        for (const p of data.pending) {
            const card = document.createElement('div');
            card.className = 'approval';
            card.innerHTML = '<div class="approval-title">⛔ ' + escape(p.tool) + ' demande une validation</div>'
                + '<code>' + escape(JSON.stringify(p.arguments)) + '</code>'
                + '<div class="approval-actions">'
                + '<button class="btn btn-primary btn-sm" data-ok="1">Autoriser</button>'
                + '<button class="btn btn-ghost btn-sm" data-ok="0">Refuser</button>'
                + '</div>';
            for (const button of card.querySelectorAll('button')) {
                button.addEventListener('click', async () => {
                    card.remove();
                    await fetch(base + '/decision', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({callId: p.callId, approved: button.dataset.ok === '1'}),
                    });
                    setTimeout(refresh, 400);
                });
            }
            approvals.append(card);
        }

        if (mode.value !== data.mode) { mode.value = data.mode; }

        state.textContent = data.finished ? 'terminé'
            : (data.pending.length ? 'suspendu — en attente de ta décision'
            : (data.working ? 'l’agent travaille…' : 'suspendu — en attente d’un signal'));
        state.dataset.working = data.working ? '1' : '0';
        if (!data.working) { pending = null; }
        if (atBottom) { thread.scrollTop = thread.scrollHeight; }
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) { return; }
        input.value = '';
        pending = text;
        await refresh();
        await fetch(base + '/message', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({text}),
        });
        setTimeout(refresh, 300);
    });

    mode.addEventListener('change', async () => {
        await fetch(base + '/mode', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({mode: mode.value}),
        });
        setTimeout(refresh, 400);
    });

    refresh();
    setInterval(refresh, 1200);
})();
</script>
{% endblock %}
