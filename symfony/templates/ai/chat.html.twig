{% extends 'base.html.twig' %}

{% block title %}Chat durable — Durable{% endblock %}

{% block body %}
<div class="container-sm">
    <div style="margin-bottom: 1.5rem;">
        <a href="{{ path('durable_samples_index') }}" class="back-link">← Retour aux samples</a>
    </div>

    <div class="page-intro">
        <h1>Chat durable</h1>
        <p>
            Une conversation = <strong>une exécution de workflow</strong>. Chaque message part en
            <strong>signal</strong> ; entre deux messages le workflow n’attend pas dans un processus,
            il est <em>suspendu</em>. Le fil affiché est une projection du journal — rien n’est stocké
            en session.
        </p>
        <p>
            Chaque appel d’outil passe par une <strong>garde</strong>. Le mode décide de ce qui passe
            sans demander ; le reste <em>suspend le workflow</em> jusqu’à ta décision — signal
            <code>tool_decision</code>. Essaie « envoie un mail » en mode <code>auto</code> puis en
            <code>standard</code>.
        </p>
    </div>

    <div class="chat">
        <div class="chat-meta">
            <span>executionId</span>
            <code>{{ executionId }}</code>
            <label class="chat-mode">
                mode
                <select id="mode" class="ds-input">
                    <option value="standard">standard — seules les lectures passent</option>
                    <option value="edition">edition — les écritures passent</option>
                    <option value="auto">auto — tout passe</option>
                </select>
            </label>
        </div>


        <div class="chat-thread" id="thread"></div>

        <span class="chat-state" id="state">…</span>

        <form class="chat-form" id="form" autocomplete="off">
            <input class="ds-input" id="text" name="text" placeholder="Demande la météo à Paris, à Lyon…" required>
            <button class="btn btn-primary" type="submit">Envoyer</button>
        </form>

        <div class="chat-resume" id="resume" hidden>
            <p>
                L’exécution est terminée — une heure sans un mot, ou la conversation close. Elle ne
                se rouvre pas : reprendre en ouvre une <strong>neuve</strong>, qui repart d’un
                <strong>résumé</strong> de celle-ci. Le résumé est un appel modèle du run repris,
                donc journalisé : rien n’est stocké entre les deux, tout sort du journal.
            </p>
            <button class="btn btn-primary" id="resume-btn" type="button">Reprendre la conversation</button>
        </div>
    </div>
</div>

<style>
    .chat { display: flex; flex-direction: column; gap: 1rem; }
    .chat-meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: .82rem; color: var(--ds-text-muted); }
    .chat-state { align-self: flex-start; margin-bottom: -.5rem; padding: .1rem .55rem; font-size: .78rem;
        color: var(--ds-text-muted); border-radius: 999px; border: 1px solid var(--ds-border-soft); }
    .chat-state[data-working="1"] { color: var(--ds-warning); border-color: var(--ds-warning); }

    /* Deux attentes, deux signes — et surtout pas le même. Une roue qui tourne dit « ça calcule,
       laisse faire » ; un battement dit « ça t'attend, toi ». Mettre la roue sur une validation
       ferait patienter devant sa propre décision. */
    @keyframes dz-spin { to { transform: rotate(360deg); } }
    @keyframes dz-pulse { 50% { opacity: .35; } }
    .spin::before { content: ''; display: inline-block; width: .68em; height: .68em; margin-right: .45em;
        vertical-align: -.06em; border: 2px solid currentColor; border-right-color: transparent;
        border-radius: 50%; animation: dz-spin .7s linear infinite; }
    .waits-on-you::before { content: ''; display: inline-block; width: .5em; height: .5em; margin-right: .5em;
        vertical-align: .04em; background: currentColor; border-radius: 50%;
        animation: dz-pulse 1.4s ease-in-out infinite; }
    /* Le mouvement est une information, pas une décoration : qui l'a désactivé garde le signe,
       il cesse simplement de bouger. */
    @media (prefers-reduced-motion: reduce) {
        .spin::before, .waits-on-you::before { animation: none; }
        .spin::before { border-right-color: currentColor; opacity: .5; }
    }
    .msg-working { align-self: flex-start; color: var(--ds-text-muted); background: transparent;
        border: 1px dashed var(--ds-border-soft); font-size: .82rem; }
    .msg-tool.spin { color: var(--ds-warning); border-color: var(--ds-warning); }
    /* Les cartes sont en colonne flex : un `::before` sur la carte deviendrait un enfant flex à
       lui tout seul, sur sa propre ligne. Le battement va donc sur leur titre. */
    .approval.waits-on-you::before { content: none; }
    .approval.waits-on-you > .approval-title::before,
    .approval.waits-on-you > .question-header::before,
    .approval.waits-on-you > .question-text:first-child::before { content: ''; display: inline-block;
        width: .5em; height: .5em; margin-right: .5em; vertical-align: .12em; background: currentColor;
        border-radius: 50%; animation: dz-pulse 1.4s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) {
        .approval.waits-on-you > .approval-title::before,
        .approval.waits-on-you > .question-header::before,
        .approval.waits-on-you > .question-text:first-child::before { animation: none; }
    }
    .chat-thread { display: flex; flex-direction: column; gap: .7rem; min-height: 18rem; max-height: 60vh; overflow-y: auto;
        padding: 1rem; background: rgba(21, 15, 35, .55); border: 1px solid var(--ds-border); border-radius: var(--radius); }
    .msg { max-width: 82%; padding: .6rem .85rem; border-radius: var(--radius); line-height: 1.5; white-space: pre-wrap; }
    .msg-user { align-self: flex-end; background: var(--ds-surface-alt); border: 1px solid var(--ds-border-soft); }
    .msg-assistant { align-self: flex-start; background: var(--ds-surface); border: 1px solid var(--ds-border); }
    .msg-tool { align-self: flex-start; max-width: 92%; font-family: var(--font-mono); font-size: .8rem;
        color: var(--ds-text-muted); background: transparent; border: 1px dashed var(--ds-border-soft); }
    .msg-tool b { color: var(--ds-accent); font-weight: 500; }
    /* Replié par défaut : le raisonnement se consulte, il ne se lit pas. `<details>` fait déjà
       tout — l'ouverture, le clavier, l'état — inutile d'écrire un accordéon. */
    .msg-thinking { align-self: flex-start; max-width: 92%; padding: 0; background: transparent;
        border: 1px dashed var(--ds-border-soft); white-space: normal; }
    .msg-thinking > summary { padding: .35rem .75rem; font-size: .78rem; cursor: pointer;
        color: var(--ds-text-muted); list-style: none; }
    .msg-thinking > summary::-webkit-details-marker { display: none; }
    .msg-thinking > summary::before { content: '▸ '; }
    .msg-thinking[open] > summary::before { content: '▾ '; }
    .msg-thinking > div { padding: 0 .75rem .6rem; font-size: .82rem; line-height: 1.5;
        color: var(--ds-text-muted); white-space: pre-wrap; }
    .chat-mode { display: inline-flex; align-items: center; gap: .4rem; margin-left: auto; }
    .chat-mode select { padding: .15rem .4rem; font-size: .8rem; }
    .approval { align-self: flex-start; max-width: 92%; border: 1px solid var(--ds-warning); border-radius: var(--radius);
        padding: .7rem .9rem; background: rgba(255, 178, 135, .08); display: flex; flex-direction: column; gap: .55rem; }
    .approval-title { font-weight: 500; color: var(--ds-warning); }
    .approval code { display: block; white-space: pre-wrap; }
    .approval-reason { font-size: .8rem; color: var(--ds-text-muted); }
    .approval-clock[data-urgent="1"] { color: var(--ds-danger); }
    .question { border-color: var(--ds-primary-hover); background: rgba(121, 98, 140, .12); }
    .question-header { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ds-text-muted); }
    .question-text { font-weight: 500; }
    .question-options { display: flex; flex-direction: column; gap: .4rem; }
    .question-options .option { display: flex; flex-direction: column; align-items: flex-start; gap: .1rem; text-align: left; }
    .question-options .option span { font-size: .78rem; color: var(--ds-text-muted); font-weight: 400; }
    .question-options .option[data-retenu="1"] { border-color: var(--ds-accent); color: var(--ds-accent); }
    .question-free input { width: 100%; }
    .watch { border-color: var(--ds-warning); background: rgba(255, 178, 135, .06); }
    .watch-intention { font-size: .82rem; color: var(--ds-text-muted); font-style: italic; }
    .approval-actions { display: flex; gap: .5rem; }
    .chat-form { display: flex; gap: .6rem; }
    .chat-form .ds-input { flex: 1; }
    .chat-empty { color: var(--ds-text-muted); font-size: .9rem; margin: auto; }
    .chat-resume { display: flex; flex-direction: column; gap: .7rem; align-items: flex-start;
        padding: .9rem 1rem; border: 1px solid var(--ds-border); border-radius: var(--radius);
        background: var(--ds-surface); }
    .chat-resume p { margin: 0; font-size: .85rem; color: var(--ds-text-muted); line-height: 1.5; }
</style>

<script>
(function () {
    const base = {{ path('durable_chat_show', {executionId: executionId})|json_encode|raw }};
    const fluxUrl = {{ mercure('durable/agent/' ~ executionId)|json_encode|raw }};
    const thread = document.getElementById('thread');
    const state = document.getElementById('state');
    const form = document.getElementById('form');
    const mode = document.getElementById('mode');
    const input = document.getElementById('text');
    const resume = document.getElementById('resume');
    let pending = null;

    const bubble = (cls, html) => {
        const el = document.createElement('div');
        el.className = 'msg ' + cls;
        el.innerHTML = html;
        return el;
    };
    // Le raisonnement arrive du journal comme le reste : le normaliseur le remet dans la charge du
    // tour suivant, la projection le relit. Ce n'est pas une trace de mise au point — chez un
    // fournisseur qui le signe, c'est de l'état de conversation.
    const thinkingBubble = (cle, text) => {
        const el = document.createElement('details');
        el.className = 'msg msg-thinking';
        el.open = ouverts.has(cle);
        el.addEventListener('toggle', () => el.open ? ouverts.add(cle) : ouverts.delete(cle));
        const summary = document.createElement('summary');
        summary.textContent = 'raisonnement';
        const body = document.createElement('div');
        body.textContent = text;
        el.append(summary, body);
        return el;
    };
    // L'écosystème PHP a trente ans de folklore : autant s'en servir. PHP meurt tous les ans
    // depuis 1998, les elePHPants se collectionnent, et personne ne se souvient de l'ordre des
    // arguments d'array_filter.
    const LABEURS = [
        'Réanimation de PHP, mort depuis 1998…',
        'Comptage des elePHPants sur l’étagère…',
        'Recherche de PHP 6…',
        'Vérification de l’ordre des arguments d’array_filter…',
        'Distinction de l’aiguille et de la botte de foin…',
        'Comparaison de « 0 » avec false, deux signes égal suffisent…',
        'Augmentation de memory_limit, encore…',
        'Rédaction d’une PSR pour numéroter les PSR…',
        'Résolution des dépendances Composer, plus que quatre minutes…',
        'Découverte que str_contains existe depuis PHP 8…',
        'Arbitrage du match Symfony contre Laravel…',
        'Explication de pourquoi ce n’est toujours pas RoadRunner…',
        'Attente de Xdebug…',
        'Ajout d’une exception au baseline PHPStan…',
        'Écriture de declare(strict_types=1) pour la millième fois…',
        'Installation d’un polyfill pour une fonction native…',
        'Interprétation d’un preg_match qui rend 0, false ou 1…',
        'Extinction d’une erreur avec un @…',
        'Pesée du dossier vendor…',
        'Rappel que WordPress fait quarante pour cent du web…',
        'Description d’un type dans un docblock, faute de mieux…',
    ];
    let labeur = null;
    let labeurDepuis = 0;

    // Une phrase par période de travail, renouvelée toutes les quatre secondes, jamais deux fois
    // la même d'affilée.
    const labeurCourant = () => {
        if (null === labeur || Date.now() - labeurDepuis > 4000) {
            let suivant;
            do { suivant = LABEURS[Math.floor(Math.random() * LABEURS.length)]; } while (suivant === labeur && LABEURS.length > 1);
            labeur = suivant;
            labeurDepuis = Date.now();
        }

        return labeur;
    };

    // Ce qui doit survivre à un redessin. Le fil est reconstruit à chaque changement, et sans ça
    // il emporte tout ce que la personne était en train de faire : un `<details>` ouvert se
    // referme, un champ à moitié rempli se vide, le curseur saute. Une carte d'attente est
    // justement l'endroit où l'on s'assoit et où l'on tape.
    const ouverts = new Set();       // clés des blocs dépliés
    const cartesVivantes = new Map(); // callId -> la carte déjà construite, et son minuteur

    /**
     * Une carte d'attente n'est construite qu'une fois. La rebâtir à l'identique toutes les
     * secondes coûterait le texte tapé dedans, le focus, et un minuteur de plus à chaque tour.
     */
    const carte = (callId, batir) => {
        let card = cartesVivantes.get(callId);
        if (!card) {
            card = batir();
            cartesVivantes.set(callId, card);
        }

        return card;
    };

    // Le compte à rebours vient du minuteur du journal, pas de l'ouverture de la page : un
    // rechargement ne remet pas l'échéance à zéro, elle a commencé côté workflow.
    const armerLeCompteur = (card, expiresAt, consequence) => {
        const clock = card.querySelector('.approval-clock');
        if (!clock || !expiresAt) { return; }
        const tick = () => {
            const left = Math.max(0, Math.round(expiresAt - Date.now() / 1000));
            clock.textContent = left > 0
                ? ' Sans réponse d’ici ' + (left >= 60 ? Math.floor(left / 60) + ' min ' + (left % 60) + ' s' : left + ' s') + ', ' + consequence + '.'
                : ' L’échéance est passée.';
            clock.dataset.urgent = left <= 60 ? '1' : '0';
        };
        tick();
        // Le minuteur vit et meurt avec sa carte. Tant qu'elle est réutilisée il continue seul ;
        // quand elle disparaît du journal, {@see elaguer} l'arrête. Un tableau global de minuteurs
        // n'existait que parce que le fil était rasé à chaque tour.
        card.dataset.clock = String(setInterval(tick, 1000));
    };

    const approvalBubble = (p) => {
        const card = document.createElement('div');
        card.className = 'approval waits-on-you';
        card.innerHTML = '<div class="approval-title">⛔ ' + escape(p.tool) + ' demande une validation</div>'
            + '<code>' + escape(JSON.stringify(p.arguments)) + '</code>'
            + '<div class="approval-reason">Le workflow est suspendu ici. Ta décision part en signal <code>tool_decision</code>.'
            + '<span class="approval-clock"></span></div>'
            + '<div class="approval-actions">'
            + '<button class="btn btn-primary btn-sm" data-ok="1">Autoriser</button>'
            + '<button class="btn btn-ghost btn-sm" data-ok="0">Refuser</button>'
            + '</div>';
        armerLeCompteur(card, p.expiresAt, 'la demande est refusée');

        for (const button of card.querySelectorAll('button')) {
            button.addEventListener('click', async () => {
                card.querySelector('.approval-actions').textContent = 'décision envoyée…';
                await fetch(base + '/decision', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({callId: p.callId, approved: button.dataset.ok === '1'}),
                });
                reveiller();
            });
        }
        return card;
    };

    // L'agent se met en veille : rien à décider, un événement à provoquer. La page tient ici le
    // rôle qu'une supervision ou un webhook tiendrait en production.
    const watchBubble = (w) => {
        const card = document.createElement('div');
        card.className = 'approval watch waits-on-you';
        card.innerHTML = '<div class="question-header">En veille — ' + escape(w.subject) + '</div>'
            + '<div class="question-text">' + escape(w.observation) + '</div>'
            + '<div class="watch-intention">Au réveil : ' + escape(w.intention) + '</div>'
            + '<div class="question-free"><input class="ds-input" placeholder="Ce qui s’est passé…"></div>'
            + '<div class="approval-reason">Le workflow dort ici. L’alerte part en signal <code>alerte</code>.<span class="approval-clock"></span></div>'
            + '<div class="approval-actions"><button class="btn btn-primary btn-sm">Lever l’alerte</button></div>';

        const libre = card.querySelector('.question-free input');
        const actions = card.querySelector('.approval-actions');
        const lever = async () => {
            actions.textContent = 'alerte levée…';
            card.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
            await fetch(base + '/alert', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({callId: w.callId, observation: libre.value.trim()}),
            });
            reveiller();
        };
        for (const button of card.querySelectorAll('button')) { button.addEventListener('click', lever); }
        libre.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') { event.preventDefault(); lever(); }
        });

        armerLeCompteur(card, w.expiresAt, 'la veille est abandonnée');

        return card;
    };

    // L'agent pose une question : ni validation ni refus, un choix. Une réponse libre reste
    // toujours possible — les options du modèle ne sont que des propositions.
    const questionBubble = (q) => {
        const card = document.createElement('div');
        card.className = 'approval question waits-on-you';
        card.innerHTML = (q.header ? '<div class="question-header">' + escape(q.header) + '</div>' : '')
            + '<div class="question-text">' + escape(q.question) + '</div>'
            + '<div class="question-options"></div>'
            + '<div class="question-free"><input class="ds-input" placeholder="Autre réponse…"></div>'
            + '<div class="approval-reason">Le workflow est suspendu ici. Ta réponse part en signal <code>question_answered</code>.<span class="approval-clock"></span></div>'
            + '<div class="approval-actions"></div>';

        const options = card.querySelector('.question-options');
        const actions = card.querySelector('.approval-actions');
        const libre = card.querySelector('.question-free input');
        const retenus = new Set();

        const repondre = async (answers) => {
            if (!answers.length) { return; }
            actions.textContent = 'réponse envoyée…';
            card.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
            await fetch(base + '/answer', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({callId: q.callId, answers}),
            });
            reveiller();
        };

        for (const option of q.options) {
            const button = document.createElement('button');
            button.className = 'btn btn-ghost btn-sm option';
            button.innerHTML = '<b>' + escape(option.label) + '</b>'
                + (option.description ? '<span>' + escape(option.description) + '</span>' : '');
            button.addEventListener('click', () => {
                if (!q.multiSelect) { repondre([option.label]); return; }
                retenus.has(option.label) ? retenus.delete(option.label) : retenus.add(option.label);
                button.dataset.retenu = retenus.has(option.label) ? '1' : '0';
            });
            options.append(button);
        }

        // En choix multiple il faut un moment pour dire « j'ai fini » ; en choix unique le clic
        // sur l'option suffit, et un bouton de plus serait un clic de plus pour rien.
        if (q.multiSelect) {
            const valider = document.createElement('button');
            valider.className = 'btn btn-primary btn-sm';
            valider.textContent = 'Valider';
            valider.addEventListener('click', () => repondre([...retenus, libre.value.trim()].filter(Boolean)));
            actions.append(valider);
        }

        libre.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') { event.preventDefault(); repondre([libre.value.trim()].filter(Boolean)); }
        });

        armerLeCompteur(card, q.expiresAt, 'l’agent continue sans ta réponse');

        return card;
    };

    const escape = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

    /** Une carte que le journal ne porte plus : son minuteur s'arrête avec elle. */
    const elaguer = (vivants) => {
        for (const [callId, card] of cartesVivantes) {
            if (vivants.has(callId)) { continue; }
            clearInterval(Number(card.dataset.clock));
            cartesVivantes.delete(callId);
        }
    };

    /**
     * Ce que la pastille et la bulle de travail disent, et qui change tout seul même quand le
     * journal, lui, n'a pas bougé : le labeur tourne toutes les quatre secondes.
     */
    const rafraichirLeStatut = (data, working) => {
        const dit = data.finished ? 'terminé'
            : (data.watches.length ? 'en veille — l’agent attend un événement'
            : (data.questions.length ? 'suspendu — l’agent te pose une question'
            : (data.pending.length ? 'suspendu — en attente de ta décision'
            : (working ? labeurCourant() : 'prêt'))));

        state.textContent = dit;
        if (!working) { labeur = null; }
        state.dataset.working = working ? '1' : '0';
        // La pastille porte le même signe que le fil : roue si ça calcule, battement si la balle
        // est dans ton camp, rien quand il n'y a rien à attendre.
        state.className = 'chat-state' + (working ? ' spin'
            : (!data.finished && (data.watches.length || data.questions.length || data.pending.length) ? ' waits-on-you' : ''));

        const travail = thread.querySelector('.msg-working');
        if (travail && working) { travail.textContent = labeurCourant(); }
    };

    let empreinte = null;

    async function refresh() {
        let data;
        try { data = await (await fetch(base + '/transcript')).json(); } catch (e) { return; }

        const working = data.working || null !== pending;

        // Le journal n'a pas bougé : ne pas raser le fil. C'est ce rasage — et pas le rythme du
        // sondage — qui refermait les blocs dépliés et vidait les champs à moitié remplis. Seuls
        // le labeur et la pastille, qui changent d'eux-mêmes, sont remis à jour.
        const empreinteCourante = JSON.stringify(data) + '|' + (pending ?? '');
        if (empreinteCourante === empreinte) {
            rafraichirLeStatut(data, working);

            return working;
        }
        empreinte = empreinteCourante;

        const atBottom = thread.scrollTop + thread.clientHeight >= thread.scrollHeight - 40;
        thread.replaceChildren();

        // Le message optimiste disparaît dès que le journal le porte, sinon il ferait doublon.
        if (data.messages.some((m) => m.role === 'user' && m.content === pending)) { pending = null; }

        // `pending` local : entre la soumission et sa trace au journal, l'agent travaille déjà —
        // `working` est calculé plus haut, avant le test d'empreinte.
        const pendingById = new Map(data.pending.map((p) => [p.callId, p]));
        // Une étape sans résultat, c'est une activité partie et pas revenue — le seul endroit du
        // fil où quelque chose tourne vraiment. Appariée par callId : deux appels au même outil
        // avec les mêmes arguments ne se distinguent pas autrement.
        const stepsById = new Map(data.steps.map((t) => [t.callId, t]));
        const questionsById = new Map(data.questions.map((q) => [q.callId, q]));
        const watchesById = new Map(data.watches.map((w) => [w.callId, w]));

        for (const [rang, m] of data.messages.entries()) {
            // Avant la bulle du tour : c'est ce qui l'a précédé, pas un commentaire d'après coup.
            // La clé est le rang : le fil ne fait que s'allonger, un message déjà écrit ne bouge
            // plus de place.
            if (m.role === 'assistant' && m.reasoning) { thread.append(thinkingBubble('r' + rang, m.reasoning)); }

            if (m.role === 'user') {
                thread.append(bubble('msg-user', escape(m.content)));
            } else if (m.role === 'tool') {
                thread.append(bubble('msg-tool', '⚙ <b>outil</b> → ' + escape(m.content)));
            } else if (m.role === 'assistant' && m.content) {
                thread.append(bubble('msg-assistant', escape(m.content)));
            } else if (m.role === 'assistant' && m.toolCalls.length) {
                for (const c of m.toolCalls) {
                    const waiting = pendingById.get(c.callId);
                    const asking = questionsById.get(c.callId);
                    const watching = watchesById.get(c.callId);
                    if (watching) {
                        thread.append(carte(watching.callId, () => watchBubble(watching)));
                        watchesById.delete(c.callId);
                    } else if (asking) {
                        thread.append(carte(asking.callId, () => questionBubble(asking)));
                        questionsById.delete(c.callId);
                    } else if (waiting) {
                        thread.append(carte(waiting.callId, () => approvalBubble(waiting)));
                        pendingById.delete(c.callId);
                    } else {
                        const step = stepsById.get(c.callId);
                        const inFlight = !step || step.result === null;
                        thread.append(bubble(
                            'msg-tool' + (inFlight ? ' spin' : ''),
                            (inFlight ? '' : '⚙ ') + 'appel <b>' + escape(c.tool) + '</b> ' + escape(JSON.stringify(c.arguments)),
                        ));
                    }
                }
            }
        }

        if (pending) { thread.append(bubble('msg-user', escape(pending))); }
        for (const waiting of pendingById.values()) { thread.append(carte(waiting.callId, () => approvalBubble(waiting))); }
        for (const asking of questionsById.values()) { thread.append(carte(asking.callId, () => questionBubble(asking))); }
        for (const watching of watchesById.values()) { thread.append(carte(watching.callId, () => watchBubble(watching))); }

        // Le travail machine se voit dans le fil, pas seulement dans la pastille : entre le
        // message envoyé et la réponse, il ne se passait visuellement rien.
        if (working) { thread.append(bubble('msg-working spin', escape(labeurCourant()))); }
        if (!thread.childElementCount) {
            const empty = document.createElement('p');
            empty.className = 'chat-empty';
            empty.textContent = 'Le workflow est démarré et suspendu. Envoie un message pour le réveiller.';
            thread.append(empty);
        }

        if (mode.value !== data.mode) { mode.value = data.mode; }

        elaguer(new Set([...data.pending, ...data.questions, ...data.watches].map((w) => w.callId)));
        rafraichirLeStatut(data, working);
        // Une exécution terminée n'écoute plus aucun signal : le champ ne servirait qu'à envoyer
        // des messages dans le vide.
        form.hidden = data.finished;
        resume.hidden = !data.finished;
        if (atBottom) { thread.scrollTop = thread.scrollHeight; }

        return true;
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) { return; }
        input.value = '';
        pending = text;
        await refresh();
        await fetch(base + '/message', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({text}),
        });
        reveiller();
    });

    mode.addEventListener('change', async () => {
        await fetch(base + '/mode', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({mode: mode.value}),
        });
        reveiller();
    });

    document.getElementById('resume-btn').addEventListener('click', async (event) => {
        event.target.disabled = true;
        event.target.textContent = 'reprise…';
        const response = await fetch(base + '/resume', {method: 'POST'});
        window.location.href = (await response.json()).url;
    });

    // Sonder à cadence fixe interroge une conversation endormie aussi souvent qu'une conversation
    // active. La cadence s'étire quand rien ne bouge et se resserre dès que quelque chose se passe
    // — et surtout dès que *tu* fais quelque chose : sans ce réveil, on répondrait à une question
    // puis on attendrait la fin du repli avant de voir le fil avancer.
    //
    // ponytail: un `setTimeout` qui se replanifie, pas un `setInterval` qu'on recrée. Le vrai
    // remède au sondage est un canal poussé (Mercure) — voir le commentaire de `transcriptJson()`.
    const CADENCE_VIVE = 700;
    // Le repli est long parce que le concentrateur couvre ce qui arrive de dehors : un message
    // envoyé depuis un autre onglet, une activité qui rend. Le sondage ne garde que ce que
    // personne ne sonne — une échéance qui tombe, une clôture sur inactivité, un relais. Sans
    // Mercure joignable, on retombe simplement sur ce rythme-là : la page reste utilisable.
    const CADENCE_MOLLE = 15000;
    let cadence = CADENCE_VIVE;
    let prochain = null;

    const planifier = (delai) => {
        clearTimeout(prochain);
        cadence = delai;
        prochain = setTimeout(boucle, delai);
    };

    const reveiller = () => planifier(CADENCE_VIVE);

    async function boucle() {
        const bouge = await refresh();
        planifier(bouge ? CADENCE_VIVE : Math.min(CADENCE_MOLLE, Math.round(cadence * 1.4)));
    }

    // Le fil reprend son rythme dès que l'onglet redevient visible : en arrière-plan le navigateur
    // brime les minuteurs, et on revient sur une conversation figée.
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { reveiller(); } });

    // Le concentrateur ne transporte que « cette exécution a bougé » : la page va chercher le fil
    // elle-même, par le chemin qu'elle connaît déjà, et l'ETag rend gratuit le cas où rien n'a
    // changé. Publier le fil ici en aurait fait une seconde projection, calculée une fois par
    // abonné dans un worker qui n'a que faire de l'affichage.
    //
    // Pas de reconnexion à gérer : une reprise ou un `?contexte=N` ouvrent une **autre** exécution,
    // donc une autre page, donc un autre flux. L'identifiant ne change jamais sous cette page.
    if (fluxUrl) {
        const flux = new EventSource(fluxUrl);
        flux.addEventListener('message', reveiller);
        // `EventSource` retente tout seul, et échoue en silence. On ne coupe donc rien : le
        // sondage lent tourne de toute façon, et c'est lui qui rattrape un concentrateur absent.
        flux.addEventListener('error', () => {});
        window.addEventListener('beforeunload', () => flux.close());
    }

    refresh();
    planifier(CADENCE_VIVE);
})();
</script>
{% endblock %}
