<div class="card-grid">
    {% for s in scenarios %}
        <article class="card">
            <div class="card-header">
                <h3 class="card-title">{{ s.label }}</h3>
                <span class="card-badge">{{ s.sourceFolder }}/</span>
            </div>
            <p class="card-description">{{ s.description }}</p>
            <div class="card-actions">
                <form method="post" action="{{ path('durable_samples_run', { id: s.id }) }}">
                    <button type="submit" class="btn btn-primary">▶ Synchronous</button>
                </form>
                <form method="post" action="{{ path('durable_samples_run', { id: s.id, wait: '0' }) }}">
                    <button type="submit" class="btn btn-ghost">⚡ Async</button>
                </form>
            </div>
        </article>
    {% else %}
        <p style="color: var(--c-muted);">No scenario registered.</p>
    {% endfor %}
</div>
