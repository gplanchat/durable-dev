{% extends 'base.html.twig' %}

{% block title %}Samples — Durable for Symfony{% endblock %}

{% block body %}
<div class="container">
    <section class="hero">
        <div class="hero__label">Durable for Symfony</div>
        <h1>Durable workflows, reliable execution, unified supervision</h1>
        <p>
            Durable orchestrates your workflows with no official Temporal PHP SDK and no RoadRunner,
            with event-sourced execution and explicit state tracking.
        </p>
        <ul class="hero__points">
            <li>Synchronous execution to validate a scenario end to end, fast.</li>
            <li>Asynchronous execution to delegate the run to dedicated workers.</li>
            <li>Event journal readable in the profiler and the dashboard.</li>
        </ul>
        <div class="hstack">
            <a href="{{ path('durable_documentation') }}" class="btn btn-primary">Read the documentation</a>
            <a href="{{ path('app_dashboard') }}" class="btn btn-ghost">Open the dashboard</a>
        </div>
    </section>

    <div class="page-intro">
        <h2>Samples workflows</h2>
        <p>
            Scenarios ported from
            <a href="https://github.com/temporalio/samples-php/tree/master/app/src">temporalio/samples-php</a>,
            rewritten for the Durable engine (with no official Temporal PHP SDK and no RoadRunner).
        </p>
        <p>
            <strong>▶ Synchronous</strong> — the page waits for the run to finish (the transports are drained in the same request);
            result and journal are immediately available in the profiler.
            <strong>⚡ Async</strong> — dispatch only (fire &amp; forget); the workflow runs in separate workers.
        </p>
    </div>

    {% include 'samples/_scenario_list.html.twig' %}
</div>
{% endblock %}
