{% extends 'base.html.twig' %}

{% block title %}Documentation — Durable for Symfony{% endblock %}

{% block body %}
<div class="container-sm">
    <div class="page-intro">
        <h1>Durable Documentation</h1>
        <p>Entry point to get to grips quickly with the Symfony demo and the Durable engine.</p>
    </div>

    <div class="result-card">
        <div class="result-card-header">Quick start</div>
        <div class="result-card-body steps">
            <ol>
                <li><strong>Start the Symfony application</strong> with <code>symfony serve</code>.</li>
                <li><strong>Explore the samples</strong>, then start a run in synchronous or async mode.</li>
                <li><strong>Follow the executions</strong> from the dashboard at <code>/dashboard</code>.</li>
                <li><strong>Open the Durable profiler</strong> for the event journal.</li>
            </ol>
        </div>
    </div>

    <div class="hstack" style="margin-top: 1rem;">
        <a href="{{ path('durable_home') }}" class="btn btn-primary">See the samples</a>
        <a href="{{ path('app_dashboard') }}" class="btn btn-ghost">Open the dashboard</a>
    </div>
</div>
{% endblock %}
