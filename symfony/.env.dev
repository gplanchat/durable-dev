
###> symfony/framework-bundle ###
APP_SECRET=a5547197d8c1529a3fe14be9867e8977
###< symfony/framework-bundle ###

###> symfony/messenger + gplanchat/durable-bridge-temporal ###
# Connexion Temporal (journal) : sans inner — alimente TemporalJournalEventStore (workflows DurableJournal dans l’UI).
# Même hôte/port que TEMPORAL_FRONTEND_PORT (.env). Exige ext-grpc en local.
DURABLE_TEMPORAL_DSN=temporal://127.0.0.1:7234?namespace=default&journal_task_queue=durable-journal&tls=0
#
# Files Messenger : transport Doctrine. Noms de files suffixés `_spike` : la base de dev est
# partagée avec l'autre worktree et ses files portent des messages d'une version antérieure du code
# (classe WorkflowRunMessage disparue) qui bloquent tout consommateur. On les laisse où ils sont.
MESSENGER_DURABLE_WORKFLOW_DSN=temporal://127.0.0.1:7234?namespace=default&inner=doctrine%3A%2F%2Fdefault%3Fqueue_name%3Ddurable_workflows_spike%26auto_setup%3Dtrue
MESSENGER_DURABLE_ACTIVITY_DSN=temporal://127.0.0.1:7234?namespace=default&inner=doctrine%3A%2F%2Fdefault%3Fqueue_name%3Ddurable_activities_spike%26auto_setup%3Dtrue
###< symfony/messenger + gplanchat/durable-bridge-temporal ###
