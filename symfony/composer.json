{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../src/Durable",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../src/DurableBundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../src/Bridge/Temporal",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../src/DurableDemoContracts",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": ">=2.19.0",
        "gplanchat/durable": "@dev",
        "gplanchat/durable-bridge-temporal": "@dev",
        "gplanchat/durable-bundle": "@dev",
        "gplanchat/durable-demo-contracts": "@dev",
        "symfony/console": "^7.4.17 || ^8.0",
        "symfony/doctrine-messenger": "^7.4.15 || ^8.0",
        "symfony/dotenv": "^7.4.15 || ^8.0",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^7.4.17 || ^8.0",
        "symfony/runtime": "^7.4.14 || ^8.0",
        "symfony/uid": "^7.4.17 || ^8.0",
        "symfony/yaml": "^7.4.17 || ^8.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.56",
        "symfony/browser-kit": "^7.4.17 || ^8.0",
        "symfony/twig-bundle": "^7.4.15 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4.17 || ^8.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "php bin/phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
