{
    "name": "gplanchat/durable-monorepo",
    "description": "Monorepo root: gplanchat/durable + bridge + bundle (dev tooling only).",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/gplanchat/durable-dev/issues",
        "source": "https://github.com/gplanchat/durable-dev"
    },
    "type": "project",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "path",
            "url": "src/Durable"
        },
        {
            "type": "path",
            "url": "src/DurableBundle"
        },
        {
            "type": "path",
            "url": "src/DurablePlugin"
        },
        {
            "type": "path",
            "url": "src/Bridge/Temporal"
        },
        {
            "type": "path",
            "url": "src/Bridge/Dbal"
        },
        {
            "type": "path",
            "url": "src/Bridge/Illuminate"
        },
        {
            "type": "path",
            "url": "src/DurableLaravel"
        },
        {
            "type": "path",
            "url": "src/DurablePhpstan"
        },
        {
            "type": "path",
            "url": "src/DurableRector"
        }
    ],
    "require": {
        "php": ">=8.2",
        "gplanchat/durable": "@dev",
        "gplanchat/durable-bundle": "@dev",
        "gplanchat/durable-plugin": "@dev",
        "gplanchat/durable-bridge-temporal": "@dev",
        "gplanchat/durable-bridge-dbal": "@dev",
        "gplanchat/durable-bridge-illuminate": "@dev",
        "gplanchat/durable-laravel": "@dev"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "gplanchat/durable-phpstan": "@dev",
        "gplanchat/durable-rector": "@dev",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/polyfill-php85": "^1.33",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Gplanchat\\Durable\\": "src/Durable/",
            "Gplanchat\\Durable\\Bundle\\": "src/DurableBundle/",
            "Gplanchat\\Durable\\Plugin\\": "src/DurablePlugin/",
            "Gplanchat\\Bridge\\Temporal\\": "src/Bridge/Temporal/",
            "Gplanchat\\Bridge\\Dbal\\": "src/Bridge/Dbal/",
            "Gplanchat\\Bridge\\Illuminate\\": "src/Bridge/Illuminate/",
            "Gplanchat\\Durable\\Laravel\\": "src/DurableLaravel/",
            "Temporal\\Api\\": "src/Bridge/Temporal/Api/",
            "GPBMetadata\\Temporal\\": "src/Bridge/Temporal/Generated/GPBMetadata/Temporal/",
            "Gplanchat\\DurableModule\\": "src/DurableModule/",
            "Gplanchat\\Durable\\Demo\\Contracts\\": "src/DurableDemoContracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "unit\\": "tests/unit/",
            "integration\\": "tests/integration/"
        },
        "files": [
            "tests/unit/DurableRector/Source/temporal-sdk-stubs.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text --exclude-testsuite rector",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse",
        "phpstan-magento": "vendor/bin/phpstan analyse -c phpstan-magento.neon --memory-limit=2G",
        "psalm": "vendor/bin/psalm",
        "psalm-magento": "vendor/bin/psalm -c psalm-magento.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@gyroscops.com"
        }
    ]
}
