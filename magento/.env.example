# This bench's default ports avoid the ones the repository's other benches
# already occupy. MySQL is on 33306 because `sylius/` holds 3306, and Temporal
# on 7234 because a `temporal server start-dev` holds 7233 — that is the one
# the integration suite starts. Two benches fighting over a port only show up
# at `docker compose up`, and the message does not name the culprit.
#
# Magento's `env.php` has to carry the same port: 'host' => '127.0.0.1:33306'.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento
MYSQL_PORT=33306

OPENSEARCH_PORT=9201
REDIS_PORT=6379

POSTGRES_VERSION=16
POSTGRES_DB=temporal
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_PORT=5433

TEMPORAL_FRONTEND_PORT=7234
TEMPORAL_UI_PORT=8088

DURABLE_DSN=temporal://127.0.0.1:7234?namespace=default&journal_task_queue=durable-journal&activity_task_queue=durable-activities&tls=0
