# Les ports par défaut de ce banc évitent ceux que les autres bancs du dépôt
# occupent déjà. MySQL est en 33306 parce que `sylius/` tient 3306, et Temporal
# en 7234 parce qu'un `temporal server start-dev` en tient 7233 — c'est celui
# que la suite d'intégration démarre. Deux bancs qui se disputent un port ne se
# voient qu'au `docker compose up`, et le message ne nomme pas le coupable.
#
# `env.php` de Magento doit porter le même port : 'host' => '127.0.0.1:33306'.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento
MYSQL_PORT=33306

OPENSEARCH_PORT=9201
REDIS_PORT=6379

POSTGRES_VERSION=16
POSTGRES_DB=temporal
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_PORT=5433

TEMPORAL_FRONTEND_PORT=7234
TEMPORAL_UI_PORT=8088

DURABLE_DSN=temporal://127.0.0.1:7234?namespace=default&journal_task_queue=durable-journal&activity_task_queue=durable-activities&tls=0
