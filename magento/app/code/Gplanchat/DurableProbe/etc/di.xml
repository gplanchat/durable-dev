<?xml version="1.0"?>
<!--
    The bench module adds its workflows and its activity handlers to the arrays the published
    module leaves **empty**. This is the 3.1 mechanism used by a third party, which proves it along
    the way: a project adds its own exactly like this.

    It carries the demonstration (`PlaceOrderWorkflow`, `durable:demo`) and the probes. None of
    that is in the published package: an integration module has no business making a consuming
    project carry workflows that are not its own.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Gplanchat\DurableModule\Runtime\RuntimeFactory">
        <arguments>
            <argument name="workflowClasses" xsi:type="array">
                <item name="probe_slow_order" xsi:type="string">Gplanchat\DurableProbe\Workflow\SlowOrderWorkflow</item>
                <item name="demo_place_order" xsi:type="string">Gplanchat\DurableProbe\Workflow\PlaceOrderWorkflow</item>
                <!-- The observation screen's acceptance vehicle: every case in a single execution. -->
                <item name="probe_every_case" xsi:type="string">Gplanchat\DurableProbe\Workflow\EveryCaseWorkflow</item>
                <item name="probe_every_case_child" xsi:type="string">Gplanchat\DurableProbe\Workflow\EveryCaseChildWorkflow</item>
                <!--
                    The caller of the three-mockup Nexus demonstration. It has no activity:
                    everything it does is served elsewhere, so the bench has no activity worker
                    to start for it.
                -->
                <item name="demo_order_nexus" xsi:type="string">Gplanchat\DurableProbe\Workflow\OrderNexusWorkflow</item>
            </argument>
            <argument name="activityHandlers" xsi:type="array">
                <item name="probe_order" xsi:type="object">Gplanchat\DurableProbe\Workflow\Activity\RecordingOrderActivities</item>
                <item name="demo_order" xsi:type="object">Gplanchat\DurableProbe\Workflow\Activity\DemoOrderActivities</item>
                <item name="probe_every_case" xsi:type="object">Gplanchat\DurableProbe\Workflow\Activity\ProbeEveryCaseActivities</item>
            </argument>
        </arguments>
    </type>

    <!-- `durable:demo` is a command of the **bench**, not of the published package. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="durable_demo" xsi:type="object">Gplanchat\DurableProbe\Console\Command\RunDemoCommand</item>
                <item name="durable_demo_nexus" xsi:type="object">Gplanchat\DurableProbe\Console\Command\RunNexusDemoCommand</item>
            </argument>
        </arguments>
    </type>
</config>
