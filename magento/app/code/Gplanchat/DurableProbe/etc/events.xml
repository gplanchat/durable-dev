<?xml version="1.0"?>
<!--
    §5.2: a placed order triggers a durable execution.

    `sales_order_place_after` is the event `Magento\Sales\Model\Order::place()` emits — the one
    Magento really emits, not a hook invented for the demonstration. It is the same one whether the
    order comes from the checkout, from the REST API or from the admin.

    The observer lives at the **bench**, not in the published package: which workflow starts on
    which order is a project decision, and the module has no business imposing one. What it
    provides is `RuntimeFactory::workflowClient()` — the door.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_place_after">
        <observer name="durable_probe_start_workflow"
                  instance="Gplanchat\DurableProbe\Observer\StartOrderWorkflow"/>
    </event>
</config>
