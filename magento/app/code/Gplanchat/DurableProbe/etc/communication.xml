<?xml version="1.0"?>
<!--
    The §1.3 probe topic: measuring what a consumer leaves behind it when its
    process dies half way through a message. The bench has no AMQP, so it is
    `Magento\MysqlMq` that answers — and its redelivery does not have AMQP's
    rules.

    It lives at the bench and does not enter `gplanchat/durable-magento`: a
    topic whose handler does nothing but sleep has no business in a published
    package. The four files of 4.1 (resume, activity, signal, update, timer)
    will be written in the module, not here.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <topic name="gplanchat.durable.probe" request="string">
        <handler name="durableProbe" type="Gplanchat\DurableProbe\Queue\ProbeHandler" method="process"/>
    </topic>
</config>
