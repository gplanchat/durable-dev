#!/usr/bin/env bash
#
# Prepares the cluster for the four-application Nexus demonstration.
#
# Seven things do not exist until somebody creates them, and none of them belongs to the code: four
# namespaces, and the three endpoints that say where `stock`, `billing` and `delivery` are served.
# That is deployment, and it is why this lives in an operator's script rather than in a class.
#
# ⚠ There are four namespaces and **three** endpoints, and that is not an omission: an endpoint says
# where a service is served, and the Magento mockup serves none. Creating one nobody would poll
# would give a caller waiting for nothing, the exact breakdown this script exists to avoid. The
# Laravel mockup does serve `delivery`: it therefore has both.
#
# The endpoint is the piece one forgets. Without it the calling workflow leaves, the server does not
# know where to route the operation, and the caller's history stops on a failure naming an
# unreachable endpoint, not the contract, not the handler.
#
#   bin/demo-nexus                     # creates what is missing, touches nothing that exists
#   bin/demo-nexus --address host:port # against a cluster other than 127.0.0.1:7233
#
set -euo pipefail

ADDRESS="${TEMPORAL_ADDRESS:-127.0.0.1:7233}"
SHOP="demo-shop"
BUSINESS="demo-business"
# The third mockup, a caller only: it has a namespace because an execution lives somewhere, and no
# endpoint because it serves nothing.
MAGENTO="demo-magento"
LARAVEL="demo-laravel"
ENDPOINT_STOCK="demo-shop-stock"
ENDPOINT_BILLING="demo-business-billing"
ENDPOINT_DELIVERY="demo-laravel-delivery"
# The queue the shop's Nexus worker polls. It is named in its DSN (`nexus_task_queue=`), and the
# endpoint must point at the same one: it is the only place the two halves meet, and a typo there
# gives a caller waiting for nothing.
QUEUE_SHOP="demo-shop-nexus"
QUEUE_BUSINESS="demo-business-nexus"
QUEUE_LARAVEL="demo-laravel-nexus"

while [ $# -gt 0 ]; do
    case "$1" in
        --address) ADDRESS="$2"; shift 2 ;;
        --address=*) ADDRESS="${1#*=}"; shift ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done

if ! command -v temporal >/dev/null 2>&1; then
    echo "temporal (the CLI) is not on the PATH: https://docs.temporal.io/cli" >&2
    exit 1
fi

tctl() { temporal --address "$ADDRESS" "$@"; }

create_namespace() {
    local name="$1"
    if tctl operator namespace describe "$name" >/dev/null 2>&1; then
        echo "  = namespace $name"
        return
    fi
    tctl operator namespace create "$name" >/dev/null
    echo "  + namespace $name"
}

echo "cluster $ADDRESS"
create_namespace "$SHOP"
create_namespace "$BUSINESS"
create_namespace "$MAGENTO"
create_namespace "$LARAVEL"

create_endpoint() {
    local name="$1" namespace="$2" queue="$3"

    if tctl operator nexus endpoint get --name "$name" >/dev/null 2>&1; then
        echo "  = endpoint $name"
        return
    fi

    # The creation fails while the target namespace has not propagated yet; a few seconds are
    # enough, and retrying beats asking the operator to run the script again.
    local attempt
    for attempt in 1 2 3 4 5; do
        if tctl operator nexus endpoint create \
            --name "$name" \
            --target-namespace "$namespace" \
            --target-task-queue "$queue" >/dev/null 2>&1; then
            echo "  + endpoint $name -> $namespace / $queue"
            return
        fi
        sleep 2
    done

    echo "could not create the endpoint $name" >&2
    echo "a server answering \"Nexus APIs are disabled\" is not enough; see demo/README.md" >&2
    exit 1
}

create_endpoint "$ENDPOINT_STOCK" "$SHOP" "$QUEUE_SHOP"
create_endpoint "$ENDPOINT_BILLING" "$BUSINESS" "$QUEUE_BUSINESS"
create_endpoint "$ENDPOINT_DELIVERY" "$LARAVEL" "$QUEUE_LARAVEL"

cat <<END

Eight processes, four namespaces. All four mockups call, three of them serve.

  # the shop serves "stock": demo profile, DBAL journal, dashboard unchanged
  cd sylius
  export APP_ENV=demo
  export DURABLE_TEMPORAL_DSN='temporal://$ADDRESS?namespace=$SHOP&nexus_task_queue=$QUEUE_SHOP&tls=0'
  bin/console messenger:consume durable_temporal_nexus

  # the shop calls "billing": demo_caller profile, journal on the cluster
  cd sylius
  export APP_ENV=demo_caller
  export DURABLE_TEMPORAL_DSN='temporal://$ADDRESS?namespace=$SHOP&tls=0'
  bin/console messenger:consume durable_temporal_journal
  bin/console durable:demo:bill CMD-1 1200

  # the business serves "billing", including "charge" which a workflow fulfils
  cd symfony
  export DURABLE_DSN='temporal://$ADDRESS?namespace=$BUSINESS&nexus_task_queue=$QUEUE_BUSINESS&tls=0'
  bin/console messenger:consume durable_temporal_nexus
  bin/console messenger:consume durable_temporal_journal
  bin/console messenger:consume durable_temporal_activity

  # the business calls "stock"
  cd symfony
  bin/console durable:demo:nexus CMD-1 MUG_BLUE=2

  # Magento calls the three services, and serves none
  cd magento
  export MAGENTO_DC_DURABLE__TEMPORAL__DSN='temporal://$ADDRESS?namespace=$MAGENTO&tls=0'
  bin/magento durable:worker --role=journal
  bin/magento durable:demo:nexus MAG-1 1200 MUG_BLUE=1

  # the logistics serves "delivery", including "ship" which a workflow fulfils, and which calls
  # "stock" while it serves
  cd laravel
  export DURABLE_DSN='temporal://$ADDRESS?namespace=$LARAVEL&nexus_task_queue=$QUEUE_LARAVEL&tls=0'
  php artisan durable:nexus-worker
  php artisan durable:temporal-worker

\`demo/run.sh\` does all of that at once.
END
