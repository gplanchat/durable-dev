# Local / editor noise
.DS_Store
*.swp
*~

# Work journal day files (kept locally; see documentation/journal/README.md)
documentation/journal/inbox/*.md
documentation/journal/archive/*.md

# Hugo : thème vendorisé pour inspection locale, la CI le récupère via go modules
hugo-docs/_vendor/
hugo-docs/public/
# Build --minify servi en HTTP pour vérifier le rendu : public/ et file:// mentent.
hugo-docs/public-check/
hugo-docs/resources/
hugo-docs/.hugo_build.lock

# Dépendances et caches d'outils : jamais au dépôt, chaque poste les reconstruit.
# `vendor/` sans barre initiale attrape aussi celui des paquets satellites.
vendor/
.phpunit.cache/
.php-cs-fixer.cache

# Cache du noyau Symfony construit par les tests d'intégration du bundle.
/var/
