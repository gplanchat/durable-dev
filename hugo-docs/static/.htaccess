# Static site served by Apache shared hosting (OVH).
#
# Every directive is wrapped in <IfModule>: on shared hosting, a directive
# for a missing module returns 500 for the WHOLE site, not only for
# the page concerned.

# --- HTTPS ---------------------------------------------------------------
# The certificate is provided by the host, but plain-text access stays open:
# we redirect explicitly.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # OVH terminates TLS upstream; the HTTPS variable is unreliable, the header is not.
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    # HSTS. A browser ignores this header on a plain-text response: no effect
    # on the redirect above.
    #
    # max-age deliberately short at launch. HSTS is hard to undo: the
    # browser will refuse http:// for the whole announced duration, even if the
    # certificate expires. Raise to 31536000 once the domain is stable, and
    # add includeSubDomains only if every subdomain is on HTTPS.
    Header always set Strict-Transport-Security "max-age=300"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compression ---------------------------------------------------------
# The search index is ~71 KB of JSON: it compresses by a factor of five.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Cache ---------------------------------------------------------------
# The theme's assets carry their fingerprint in the name: their content never changes
# under a given URL, so they can be kept indefinitely. The HTML, on the other hand,
# is revalidated — that is what makes a republication visible right away.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Second mod_headers block: Cache-Control complements mod_expires, which cannot
# express must-revalidate.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|xml)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Miscellaneous -------------------------------------------------------
ErrorDocument 404 /404.html

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
