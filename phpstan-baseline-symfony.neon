# Dette de l'application d'exemple, consignée le 27 août 2026 — 52 erreurs.
#
# Ce n'est pas une liste d'exceptions : c'est une dette datée. `symfony/` est resté hors de
# l'analyse statique pendant tout le développement de la bibliothèque, alors qu'il porte le code
# le plus proche de ce qu'écrira un utilisateur. Deux défauts y avaient dormi : un appel à
# `delay()`, méthode qui n'existe pas, et trois appels de stub dont le résultat n'était plus
# attendu — ceux-là, seule la CI les a vus.
#
# La ligne de base rend le périmètre effectif immédiatement : **tout code neuf est vérifié**.
# Elle ne corrige rien. Chaque entrée retirée d'ici est un défaut réel réparé, et le fichier est
# censé maigrir.
#
# Ce qu'elle ne gèle pas : rien du cœur. Les 52 entrées sont toutes sous `symfony/`.

parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_array\(\) with array\<mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: symfony/src/Controller/DashboardController.php

		-
			message: '#^Offset ''name'' on array\{name\: string, arguments\?\: array\<string, mixed\>, result\?\: mixed\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: symfony/src/Controller/SamplesWorkflowController.php

		-
			message: '#^Offset ''name'' on array\{name\: string, payload\: array\<string, mixed\>\} in isset\(\) always exists and is not nullable\.$#'
