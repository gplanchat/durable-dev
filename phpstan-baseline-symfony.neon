			path: symfony/src/Controller/SamplesWorkflowController.php

		-
			message: '#^Offset ''payload'' on array\{name\: string, payload\: array\<string, mixed\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: symfony/src/Controller/SamplesWorkflowController.php

		-
			message: '#^Offset ''running'' on array\{label\: string, start\: float, end\: float\} on left side of \?\? does not exist\.$#'
