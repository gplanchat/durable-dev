includes:
    - src/DurablePhpstan/extension.neon

parameters:
    level: 6
    paths:
        - src/Durable
        - src/DurableBundle
        - src/DurablePlugin
        - src/Bridge/Temporal
        - src/Bridge/Dbal
        - src/Bridge/Illuminate
        - src/DurableLaravel
        - src/DurablePhpstan
        - src/DurableRector
        - tests/unit
        - tests/integration
    excludePaths:
        # `illuminate/console` requires `symfony/console ^7.x` on all three of its lines, so
        # bringing it into the root graph would make the Symfony 6.4 line unresolvable — the same
        # breakage `illuminate/queue` had caused. The command is real and runs in a Laravel
        # application, which always ships illuminate/console; it is here, and here only, that it
        # cannot be analysed.
        - src/DurableLaravel/Console
        - src/Bridge/Temporal/Api
        - src/Bridge/Temporal/Generated
        - src/Bridge/Temporal/Spike
        # Code written wrong on purpose: the PHPStan rule tests feed it to the rules.
        - tests/unit/DurablePhpstan/Fixtures
        # The code the Rector rules migrate, written as a Temporal SDK user wrote it.
        - tests/unit/DurableRector/Source
        - tests/unit/DurableRector/Fixture
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # ServiceProvider::$app is typed by PHPDoc as the full application. This package depends
        # on that being false: its bindings also register in a bare container — standalone worker,
        # test — where configPath() does not exist. The guard is real, it is the upstream PHPDoc
        # that is optimistic.
        - identifier: function.alreadyNarrowedType
          path: src/DurableLaravel/DurableServiceProvider.php
        # google/protobuf stubs type MapField incorrectly — constructor expects "long" but GPBType constants are int
        - identifier: argument.type
          path: src/Bridge/Temporal/Worker/TemporalWorkflowCommandBuffer.php
        # MapField is typed as non-nullable by google/protobuf stubs, but defensive null checks are intentional
        - identifier: notIdentical.alwaysTrue
          path: src/Bridge/Temporal/Profiler/TemporalEventConverter.php
        - identifier: notIdentical.alwaysTrue
          path: src/Bridge/Temporal/Worker/TemporalExecutionHistory.php
        # Symfony 6.4 types the config builder's fluent chain more loosely than 7.x:
        # ->end() returns NodeParentInterface there, so the chain loses ArrayNodeDefinition.
        # Runtime is unaffected; the tree is the same object on every supported version.
        # Matches on the Symfony 6.4 legs only, hence no unmatched report on the lock line.
        - identifier: method.notFound
          path: src/DurableBundle/DependencyInjection/Configuration.php
          reportUnmatched: false
        # TreeBuilder is not generic on 6.4, and its template has no 'array' default on the lowest
        # 7.4 and 8.0 patches: no return type satisfies every leg. Matches on those lowest legs only.
        - identifier: missingType.generics
          path: src/DurableBundle/DependencyInjection/Configuration.php
          reportUnmatched: false
        # The tests register the Laravel provider in a bare container on purpose: that is the
        # standalone-worker case the function.alreadyNarrowedType entry above describes.
        - identifier: argument.type
          message: '#expects Illuminate\\Contracts\\Foundation\\Application#'
          paths:
              - tests/unit/DurableLaravel/*
              - tests/unit/Bridge/Illuminate/*
        # A test asserts at runtime what its types promise: an assertion PHPStan already proves is
        # still the check the test makes, and what keeps it from being a test without assertion.
        - identifier: staticMethod.alreadyNarrowedType
          path: tests/*
        # Test workflows receive their environment because the contract hands it over, payload
        # objects are serialised whole, and recorders write through a reference: none is read back.
        - identifier: property.onlyWritten
          path: tests/*
        # The same google/protobuf MapField stubs as TemporalWorkflowCommandBuffer above.
        - identifier: argument.type
          path: tests/integration/Temporal/NexusHeaderRulesTest.php
        - identifier: offsetAssign.valueType
          path: tests/integration/Temporal/NexusHeaderRulesTest.php
        # PHPStan cannot track Awaitable settlement across Fiber boundary
        - identifier: booleanNot.alwaysTrue
          path: src/Durable/ExecutionRuntime.php
        - identifier: deadCode.unreachable
          path: src/Durable/ExecutionRuntime.php
        # PHPStan resolves the concrete NullActivityHeartbeatSender stub to always-false
        - identifier: identical.alwaysFalse
          path: src/Durable/Worker/ActivityMessageProcessor.php
        # Implementing ExtendedMethodReflection steps outside PHPStan's compatibility promise:
        # the interface can change on a minor version. That is accepted and unavoidable — the only
        # way to say that a stub call returns an Awaitable rather than the contract's type is to
        # decorate the reflection. The price is known: if a minor breaks SchedulingMethod-
        # Reflection, it is its 28 delegation methods that must be realigned, and the six tests of
        # StubMethodsExtensionTest that will say so.
        - identifier: phpstanApi.interface
          path: src/DurablePhpstan/Reflection/SchedulingMethodReflection.php
        # `json_encode` appelle le `jsonSerialize()` de la valeur qu'on lui passe : du code
        # applicatif, qui peut lever. PHPStan modélise la fonction comme incapable de lever, et
        # déclare donc le `catch` mort. Il ne l'est pas — `RecordedDetailsStorableTest` le
        # contredit en exécution, et sans ce `catch` l'exception remonte jusqu'à `collect()`,
        # c'est-à-dire `kernel.response`, et emporte la requête.
        - identifier: catch.neverThrown
          path: src/Durable/Observation/RecordedDetails.php
        # DurableBundleTestTrait is consumed by application tests, not by library code
        - identifier: trait.unused
          path: src/DurableBundle/Testing/DurableBundleTestTrait.php
